{
  "schemaVersion": 60,
  "skills": [
    {
      "id": "classic:youdi",
      "revision": 1,
      "minimumRulesVersion": 170,
      "triggers": [
        {
          "id": "ending-opponent-discards-and-owner-takes",
          "window": "turnEnding",
          "subject": "owner",
          "optional": true,
          "priority": 0,
          "condition": { "kind": "classicIdentityMode" },
          "effects": [
            { "op": "selectTarget", "target": "owner", "targetKind": "otherLiving" },
            {
              "op": "selectAndMoveOwnedCard",
              "target": "owner",
              "chooserRef": { "kind": "selectedTarget" },
              "cardOwnerRef": { "kind": "owner" },
              "zones": ["hand", "equipment"],
              "count": 1,
              "destination": "discardPile",
              "resultBind": "discarded-card"
            },
            {
              "op": "selectAndMoveOwnedCard",
              "target": "owner",
              "chooserRef": { "kind": "owner" },
              "cardOwnerRef": { "kind": "selectedTarget" },
              "zones": ["hand", "equipment"],
              "count": 1,
              "destination": "ownerHand",
              "skipIfNoCards": true,
              "condition": {
                "kind": "not",
                "children": [
                  {
                    "kind": "boundCardsMatchKinds",
                    "sourceBind": "discarded-card",
                    "cardKinds": ["slash", "fireSlash", "thunderSlash"]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
