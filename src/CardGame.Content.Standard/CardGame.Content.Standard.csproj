<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardGame.Core\CardGame.Core.csproj" />
    <EmbeddedResource Include="..\Characters\**\Content\*.character.json"
                      LogicalName="CardGame.Content.Standard.Characters.%(Filename)%(Extension)"
                      WithCulture="false" />
    <EmbeddedResource Include="..\Characters\**\Skills\*.json"
                      LogicalName="CardGame.Content.Standard.SkillPrograms.%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>

</Project>
