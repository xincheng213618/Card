      "programBundle": "ol-zhang-qi-ying",
      "includeProgramPresentation": true,
      "definition": {
        "id": "ol:zhenyi",
        "name": "真仪",
        "description": "你可以在以下时机移除相应标记并触发效果：\n•“紫微”：当一张判定牌生效前，你将判定结果改为黑桃5或红桃5；\n•“后土”：你的回合外，你将一张牌当【桃】使用；\n•“玉清”：当你造成伤害时，你令此伤害+1；\n•“勾陈”：当你受到属性伤害后，你获得牌堆中三种类型的牌各一张。",
        "executionForms": "State, Trigger"
      }
