{"formatVersion":1,"packageId":"standard-classic-generals","characterId":"character:xiang-chong","skills":[{"registrationOrder":1710,"programBundle":"ol-xiang-chong","includeProgramPresentation":true,"definition":{"id":"ol:guying","name":"固营","description":"锁定技，每回合限一次，当你于回合外失去一张牌后，当前回合角色选择一项：1.随机交给你一张牌；2.你获得此牌，若为装备牌则改为使用之。准备阶段，你弃置X张牌（X为此前此技能发动过的次数），并重置此技能发动次数。","executionForms":"Trigger"}},{"registrationOrder":1711,"programBundle":"ol-xiang-chong","includeProgramPresentation":true,"definition":{"id":"ol:muzhen","name":"睦阵","description":"出牌阶段限一次，你可以将两张牌交给一名有装备牌的其他角色，然后获得其装备区里的一张牌；出牌阶段限一次，你可以将一张装备牌置入其他角色的装备区，然后获得其一张手牌。","actionForms":"Active"}}],"generals":[{"registrationOrder":1712,"pools":{"current":449},"definition":{"id":"ol:xiang-chong","name":"向宠","portraitKey":"ol-xiang-chong","skillId":"ol:guying","additionalSkillIds":["ol:muzhen"],"factionId":"shu","baseHp":4,"gender":"Male","characterId":"character:xiang-chong","variantId":"ordinary","rulesetId":"sanguosha-ol"}}]}
