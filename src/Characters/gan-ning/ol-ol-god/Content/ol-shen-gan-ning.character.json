      "includeProgramPresentation": true,
      "definition": {
        "id": "ol:shen-gan-ning-jieying",
        "name": "劫营",
        "description": "回合开始时，若场上没有“营”标记，你获得“营”。结束阶段，你可以将“营”置于一名角色的武将牌上。有“营”的角色摸牌阶段多摸一张牌、出牌阶段使用【杀】的限制次数+1、手牌上限+1。有“营”的其他角色回合结束后，你获得其所有手牌和“营”。",
        "executionForms": "State, Trigger"
      }
    }
