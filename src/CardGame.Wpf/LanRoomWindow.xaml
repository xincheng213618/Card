<Window x:Class="CardGame.Wpf.LanRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网 · 模式与房间" Width="1320" Height="880" MinWidth="1000" MinHeight="700"
        Background="#171C25" Foreground="#F0E6D4" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDE3D0" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#D7B778"/><Setter Property="Foreground" Value="#1B2029"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F0E6D4"/><Setter Property="Margin" Value="7"/></Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#232B37"/><Setter Property="BorderBrush" Value="#4F5158"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18" Background="#171C25">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="6,0,6,12">
            <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="局域网原型 · 标准 108 张牌" Foreground="#B6A58B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Visibility="{Binding InLobby, Converter={StaticResource Visible}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="服务器地址" Margin="4,0"/><TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="服务器地址"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="你的昵称" Margin="4,0"/><TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="玩家昵称"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="模式" Margin="4,0"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name" AutomationProperties.Name="房间模式"/></StackPanel>
                <Button Grid.Column="3" Content="刷新房间" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Visibility="{Binding InLobby, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="房间列表" FontSize="19" Margin="0,0,0,12"/>
                    <ListView ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Background="#1B222E" Foreground="#EDE3D0" BorderThickness="0" AutomationProperties.Name="房间列表">
                        <ListView.View><GridView>
                            <GridViewColumn Header="房间号" DisplayMemberBinding="{Binding Id}" Width="130"/>
                            <GridViewColumn Header="房间名称" DisplayMemberBinding="{Binding Name}" Width="350"/>
                            <GridViewColumn Header="人数" DisplayMemberBinding="{Binding Occupancy}" Width="300"/>
                            <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="140"/>
                        </GridView></ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="进入选中房间" Command="{Binding JoinCommand}"/>
                    <Button DockPanel.Dock="Right" Content="创建房间" Command="{Binding CreateCommand}"/>
                    <Button DockPanel.Dock="Right" Content="快速开始（单机）" Command="{Binding QuickStartCommand}" ToolTip="沿用单机模式，其他座位自动补齐 AI。"/>
                    <StackPanel MaxWidth="300" HorizontalAlignment="Left"><TextBlock Text="新房间名称"/><TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" Width="270" MaxLength="30"/></StackPanel>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding InRoom, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.3*" MinHeight="270"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="0.9*"/><Setter Property="MinHeight" Value="210"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasGame}" Value="False"><Setter Property="Height" Value="0"/><Setter Property="MinHeight" Value="0"/></DataTrigger></Style.Triggers>
                    </Style></RowDefinition.Style></RowDefinition>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Seats}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Panel}" MinHeight="144" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Badge}" Foreground="#D7B778" FontSize="12"/>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap" MinHeight="42"/>
                                    <Button Content="添加 AI" Visibility="{Binding CanAddAi, Converter={StaticResource Visible}}" Command="{Binding DataContext.AddAiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="移除 AI" Visibility="{Binding CanRemoveAi, Converter={StaticResource Visible}}" Command="{Binding DataContext.RemoveAiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <StackPanel><TextBlock Text="{Binding Prompt}" FontSize="16" TextWrapping="Wrap"/>
                        <TextBlock Text="你的手牌" Foreground="#D7B778" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding HandText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Panel}" Visibility="{Binding HasGame, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Background="#1B222E" Foreground="#F0E6D4" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="当前可用操作">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Grid.Column="1" Margin="15,0,0,0">
                            <Button DockPanel.Dock="Bottom" Content="确认操作" Command="{Binding SubmitCommand}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock Text="{Binding SelectionHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <ItemsControl ItemsSource="{Binding Targets}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="房间管理" FontSize="19" Margin="0,0,0,12"/>
                        <Button Content="补齐 AI" Command="{Binding FillAiCommand}" Visibility="{Binding CanManageSeats, Converter={StaticResource Visible}}"/>
                        <Button Content="{Binding ReadyLabel}" Command="{Binding ReadyCommand}" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}"/>
                        <Button Content="开始对局" Command="{Binding StartCommand}" Visibility="{Binding CanManageSeats, Converter={StaticResource Visible}}"/>
                        <Button Content="返回房间列表" Command="{Binding BackCommand}" ToolTip="等待中离开座位；对局中保留座位，可从同一应用重新进入。"/>
                        <Button Content="确认上次操作" Command="{Binding RetryCommand}" Visibility="{Binding HasUncertainInput, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="房间动态" Foreground="#D7B778" Margin="0,18,0,8"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding LogText}" TextWrapping="Wrap" FontSize="13" LineHeight="23"/></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#D7B778" Margin="10,9"/>
    </Grid>
</Window>
