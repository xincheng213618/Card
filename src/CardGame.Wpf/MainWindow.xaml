                            <Expander x:Name="GeneralLibraryOverview" Header="武将库" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,8" Visibility="{Binding HasGeneralLibraries, Converter={StaticResource BoolToVisibility}}">
