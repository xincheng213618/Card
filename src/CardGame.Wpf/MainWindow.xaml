<Window x:Class="CardGame.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CardGame.Wpf.Controls" controls:InteractionMotion.MotionEnabled="{Binding IsMotionEnabled}" Title="{Binding WindowTitle}" Width="1440" Height="920" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" Background="{StaticResource TableDeepBrush}" PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="BattleLogScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BattleLogScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" /><Setter Property="Background" Value="#987D4D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="6" Margin="0,1" Background="{TemplateBinding Background}" BorderBrush="#C2A46A" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#C7AA6B" /><Setter TargetName="Grip" Property="BorderBrush" Value="#E8CD93" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#E1C284" /><Setter TargetName="Grip" Property="BorderBrush" Value="#F6DFAD" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BattleLogScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="MinWidth" Value="0" /><Setter Property="MaxWidth" Value="10" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,2">
                            <Border Width="2" Background="#7050442F" CornerRadius="1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource BattleLogScrollPage}" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource BattleLogScrollThumb}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource BattleLogScrollPage}" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BattleLogSeatButton" TargetType="Button" BasedOn="{StaticResource SelectedFilterButton}">
            <Setter Property="Width" Value="20" /><Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="1" />
            <Setter Property="FontFamily" Value="KaiTi" /><Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#44171310" /><Setter Property="BorderBrush" Value="#81735E" />
            <Setter Property="Foreground" Value="#C5B58E" />
        </Style>
        <Style x:Key="SetupRoomSeatAction" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Content" Value="添加 AI" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Command" Value="{Binding DataContext.AddSetupRoomAiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat={}{0}添加 AI}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Human"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding CanRemoveAi}" Value="True">
                    <Setter Property="Content" Value="移除 AI" />
                    <Setter Property="Command" Value="{Binding DataContext.RemoveSetupRoomAiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat={}{0}移除 AI}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GeneralRosterCategoryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#29251E" /><Setter Property="BorderBrush" Value="#5B503B" />
            <Setter Property="Foreground" Value="#C7BDA4" /><Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#594A30" /><Setter Property="BorderBrush" Value="#D4B572" />
                    <Setter Property="Foreground" Value="#FFE4A7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartingIdentityButton" TargetType="Button" BasedOn="{StaticResource GeneralRosterCategoryButton}">
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="Tag">
                <Setter.Value><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Name" /><Binding Path="DataContext.HumanPlayer.RoleLabel" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="AutomationProperties.ItemStatus" Value="当前身份" /></Trigger></Style.Triggers>
        </Style>
        <controls:PromptCardChoiceConverter x:Key="PromptCardChoiceConverter" />
        <DataTemplate x:Key="DragonBoatStandingTemplate">
            <Border Margin="2" Padding="6,4" BorderThickness="1" CornerRadius="2" ToolTip="相同至宝数时按到达先后排序；唐咨满12枚仅在终局优先。">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E4DDD0B4" /><Setter Property="BorderBrush" Value="#8B7958" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsHumanTeam}" Value="True"><Setter Property="Background" Value="#F0E9C888" /><Setter Property="BorderBrush" Value="#8A5728" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RankText}" Foreground="#69502D" FontSize="10" /><TextBlock Text="{Binding TeamName}" Foreground="#3C3526" FontSize="13" FontWeight="Bold" /></DockPanel>
                    <TextBlock Text="{Binding TreasureText}" Foreground="#5F3E19" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ArrivalText}" Foreground="#5B5544" FontSize="9" TextAlignment="Center" />
                    <TextBlock Text="{Binding RuleText}" Foreground="#6F482C" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PromptCardChoiceContentTemplate">
            <Grid>
                <TextBlock x:Name="ChoiceDescription" Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
                <Border x:Name="ChoiceCardName" Visibility="Collapsed" Width="112" CornerRadius="4" BorderThickness="1" ToolTip="{Binding NamedCard.Description}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E8222B2B" /><Setter Property="BorderBrush" Value="#827451" />
                            <Style.Triggers><DataTrigger Binding="{Binding NamedCard.IsRecorded}" Value="True"><Setter Property="Background" Value="#F0443A27" /><Setter Property="BorderBrush" Value="#E1BD70" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Height="64" ClipToBounds="True">
                            <Image Source="{Binding NamedCard.Artwork}" Stretch="UniformToFill" Opacity="0.7" />
                            <Border Background="#A51B201E" VerticalAlignment="Bottom" Padding="3,2"><TextBlock Text="{Binding NamedCard.Category}" Foreground="#EAD7AE" FontSize="10" TextAlignment="Center" /></Border>
                        </Grid>
                        <TextBlock Text="{Binding NamedCard.Name}" Foreground="#FFE7AC" FontFamily="KaiTi" FontSize="18" TextAlignment="Center" Margin="2,5,2,2" />
                        <TextBlock Text="{Binding NamedCard.Action}" Foreground="#D4C6A5" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="4,0,4,5" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ChoiceCard" Visibility="Collapsed">
                    <Grid Width="84" Height="116">
                        <ContentControl x:Name="ChoiceFace" Content="{Binding Face}" ContentTemplate="{StaticResource CardFaceTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        <TextBlock x:Name="ChoiceSkillMark" Text="{Binding Face.OriginalHandTag}" Foreground="#F9EAC5" Background="#D074562A" FontSize="10" Padding="3,1" MaxWidth="52" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Visibility="{Binding Face.HasOriginalHandTag, Converter={StaticResource BoolToVisibility}}" />
                        <Border x:Name="ChoiceBack" Visibility="Collapsed" Background="#432C23" BorderBrush="#D7B571" BorderThickness="2" CornerRadius="5" Padding="5">
                            <Border BorderBrush="#987F50" BorderThickness="1" CornerRadius="2">
                                <Grid>
                                    <Grid.Background>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing><GeometryDrawing Brush="#53392B"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,18,18" /></GeometryDrawing.Geometry><GeometryDrawing.Pen><Pen Brush="#817044" Thickness="0.6" /></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Grid.Background>
                                    <Border Width="58" Height="80" Background="#D92C221B" BorderBrush="#BD9A5A" BorderThickness="1" CornerRadius="24">
                                        <TextBlock Text="群雄&#x0a;逐鹿" FontFamily="KaiTi" FontSize="20" Foreground="#E3C58A" TextAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCard}" Value="True"><Setter TargetName="ChoiceDescription" Property="Visibility" Value="Collapsed" /><Setter TargetName="ChoiceCard" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter TargetName="ChoiceFace" Property="Visibility" Value="Collapsed" /><Setter TargetName="ChoiceBack" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsCardName}" Value="True"><Setter TargetName="ChoiceDescription" Property="Visibility" Value="Collapsed" /><Setter TargetName="ChoiceCardName" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ReserveDialogCardTemplate">
            <Button Command="{Binding DataContext.MoveReserveCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource BareButton}" Margin="3" ToolTip="{Binding Card.Description}" AutomationProperties.Name="{Binding Card.Name}" PreviewMouseLeftButtonDown="ReserveCard_PreviewMouseLeftButtonDown" PreviewMouseMove="ReserveCard_PreviewMouseMove">
                <Border Width="94" Height="130" Background="#D8C9A5" BorderBrush="#8B754A" BorderThickness="2" CornerRadius="4">
                    <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource CardFaceTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="PrivatePileBackTemplate">
            <Border x:Name="PrivatePileCardBack" Width="94" Height="130" Margin="3" Background="#432C23" BorderBrush="#D7B571" BorderThickness="2" CornerRadius="4" Padding="5" AutomationProperties.Name="{Binding Label}">
                <Border BorderBrush="#987F50" BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing><GeometryDrawing Brush="#53392B"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,18,18" /></GeometryDrawing.Geometry><GeometryDrawing.Pen><Pen Brush="#817044" Thickness="0.6" /></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                        <Border Width="58" Height="80" Background="#D92C221B" BorderBrush="#BD9A5A" BorderThickness="1" CornerRadius="24">
                            <TextBlock Text="群雄&#xA;逐鹿" FontFamily="KaiTi" FontSize="20" Foreground="#E3C58A" TextAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RingSeatTemplate">
            <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="{DynamicResource RingSeatMaxWidth}" Margin="5,3">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SeatTemplate}" />
                    <TextBlock Text="{Binding SeatLabel}" Foreground="#F0DEC0" FontFamily="KaiTi" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="HarvestChoiceTemplate">
            <Button Command="{Binding DataContext.SelectHarvestChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TargetCardChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetCardChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="7" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                <ContentControl ContentTemplate="{StaticResource PromptCardChoiceContentTemplate}">
                    <ContentControl.Content><MultiBinding Converter="{StaticResource PromptCardChoiceConverter}"><Binding /><Binding Path="DataContext.ChoiceSnapshot" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></ContentControl.Content>
                </ContentControl>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="HandResponseChoiceTemplate">
            <Button Command="{Binding DataContext.SelectHandResponseChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <ContentControl ContentTemplate="{StaticResource PromptCardChoiceContentTemplate}">
                    <ContentControl.Content><MultiBinding Converter="{StaticResource PromptCardChoiceConverter}"><Binding /><Binding Path="DataContext.ChoiceSnapshot" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></ContentControl.Content>
                </ContentControl>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SkillChoiceTemplate">
            <Button Command="{Binding DataContext.SelectSkillChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="7" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                <ContentControl ContentTemplate="{StaticResource PromptCardChoiceContentTemplate}">
                    <ContentControl.Content><MultiBinding Converter="{StaticResource PromptCardChoiceConverter}"><Binding /><Binding Path="DataContext.ChoiceSnapshot" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></ContentControl.Content>
                </ContentControl>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ActiveSkillEquipmentChoiceTemplate">
            <Button Command="{Binding DataContext.SelectActiveSkillEquipmentChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="EquipmentPlayChoiceTemplate">
            <Button Command="{Binding DataContext.SelectEquipmentPlayChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <ContentControl ContentTemplate="{StaticResource PromptCardChoiceContentTemplate}">
                    <ContentControl.Content><MultiBinding Converter="{StaticResource PromptCardChoiceConverter}" ConverterParameter="names-only"><Binding /><Binding Path="DataContext.ChoiceSnapshot" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></ContentControl.Content>
                </ContentControl>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="CardNameSelectionTemplate">
            <Button Command="{Binding DataContext.SelectionArea.CatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" Padding="4" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                <ContentControl ContentTemplate="{StaticResource PromptCardChoiceContentTemplate}">
                    <ContentControl.Content><MultiBinding Converter="{StaticResource PromptCardChoiceConverter}" ConverterParameter="names-only"><Binding /><Binding Path="DataContext.ChoiceSnapshot" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></ContentControl.Content>
                </ContentControl>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TargetCombinationChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetCombinationChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <Style x:Key="SetupChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChoiceFrame" BorderBrush="#506358" Background="#142227" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#E2BE76" />
                                <Setter TargetName="ChoiceFrame" Property="Background" Value="#344036" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#C6BB8C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#FFE1A0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="TableSurface">
            <Grid.Style>
                <Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNewGameSetupOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHelpOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHistoryOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGeneralGalleryOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsIdentityRevealOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="TableHeader" Background="#24211E" BorderBrush="#736751" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="#A68B58" BorderThickness="1" Width="33" Height="33" Margin="0,0,12,0">
                            <TextBlock Text="弈" FontFamily="KaiTi" FontSize="24" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="群 雄 逐 鹿" FontFamily="KaiTi" FontSize="20" Foreground="#E9D2A0" />
                            <TextBlock Text="{Binding TableModeText}" FontSize="10" Foreground="#83908A" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoundText}" Foreground="{StaticResource GoldBrush}" FontSize="13" Margin="0,0,20,0" />
                        <TextBlock Text="摸牌">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDrawPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="›" Foreground="#4A5D5A" />
                        <TextBlock Text="出牌">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="›" Foreground="#4A5D5A" />
                        <TextBlock Text="弃牌">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscardPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="›" Foreground="#4A5D5A" />
                        <TextBlock Text="结束">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinishedPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新手演练" Command="{Binding StartTutorialCommand}" ToolTip="在四段真实牌局中练习基础操作" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="武将" Command="{Binding OpenGeneralGalleryCommand}" ToolTip="浏览经典身份武将、体力与技能" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="指南" Command="{Binding ToggleHelpCommand}" ToolTip="当前操作与卡牌图鉴 · F1" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="战报 / 存档" Command="{Binding ToggleLogCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button x:Name="HistoryButton" Content="战绩" Command="{Binding OpenHistoryCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="山河图" Command="{Binding OpenShanheCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="设置" Command="{Binding OpenSettingsCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="保存" Command="{Binding SaveGameCommand}" ToolTip="保存到手动存档 · F5" Style="{StaticResource QuietButton}" />
                        <Button Content="新对局" Command="{Binding NewGameCommand}" Style="{StaticResource ToolbarButton}" Margin="12,0,0,0" Padding="15,8" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" x:Name="GameArea" SizeChanged="GameArea_SizeChanged">
                <Grid.Background><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/Board.jpg" Stretch="UniformToFill" /></Grid.Background>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="HandDockRow" Height="210" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid x:Name="Battlefield" SizeChanged="Battlefield_SizeChanged">
                    <Grid Margin="12,12,12,6">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="TopSeatRow" MaxHeight="210">
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="{DynamicResource TableTopSeatHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCenterChoices}" Value="True">
                                                <Setter Property="Height" Value="*" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AreTablePlaysVisible}" Value="True">
                                                <Setter Property="Height" Value="*" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                            <RowDefinition Height="*">
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCenterChoices}" Value="True">
