                            <Expander x:Name="NamedPrivatePileOverview" Header="暗置牌堆" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,8" Visibility="{Binding HasNamedPrivatePiles, Converter={StaticResource BoolToVisibility}}">
