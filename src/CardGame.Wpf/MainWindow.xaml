<Window x:Class="CardGame.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CardGame.Wpf.Controls" Title="{Binding WindowTitle}" Width="1440" Height="920" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" Background="{StaticResource TableDeepBrush}" PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="DyingChoiceTemplate">
            <Button Command="{Binding DataContext.SelectDyingChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="HarvestChoiceTemplate">
            <Button Command="{Binding DataContext.SelectHarvestChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TargetCardChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetCardChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="FireAttackChoiceTemplate">
            <Button Command="{Binding DataContext.SelectFireAttackChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="NullificationChoiceTemplate">
            <Button Command="{Binding DataContext.SelectNullificationChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ResponseChoiceTemplate">
            <Button Command="{Binding DataContext.SelectResponseChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SkillChoiceTemplate">
            <Button Command="{Binding DataContext.SelectSkillChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ActiveSkillEquipmentChoiceTemplate">
            <Button Command="{Binding DataContext.SelectActiveSkillEquipmentChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="EquipmentPlayChoiceTemplate">
            <Button Command="{Binding DataContext.SelectEquipmentPlayChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="PublicTargetChoiceTemplate">
            <Button Command="{Binding DataContext.SelectPublicTargetChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TargetCombinationChoiceTemplate">
            <Button Command="{Binding DataContext.SelectTargetCombinationChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Margin="4" MaxWidth="380" Padding="14,9">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </DataTemplate>
        <Style x:Key="SetupChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChoiceFrame" BorderBrush="#506358" Background="#142227" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#E2BE76" />
                                <Setter TargetName="ChoiceFrame" Property="Background" Value="#344036" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#C6BB8C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#FFE1A0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="TableSurface">
            <Grid.Style>
                <Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNewGameSetupOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHelpOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHistoryOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGeneralGalleryOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsIdentityRevealOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#111A1E" BorderBrush="#59604F" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="#A68B58" BorderThickness="1" Width="33" Height="33" Margin="0,0,12,0">
                            <TextBlock Text="弈" FontFamily="KaiTi" FontSize="24" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="群 雄 逐 鹿" FontFamily="KaiTi" FontSize="24" Foreground="#E9D2A0" />
                            <TextBlock Text="{Binding TableModeText}" FontSize="10" Foreground="#83908A" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoundText}" Foreground="{StaticResource GoldBrush}" FontSize="13" Margin="0,0,20,0" />
                        <TextBlock Text="摸牌">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDrawPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="›" Foreground="#4A5D5A" />
                        <TextBlock Text="出牌">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="›" Foreground="#4A5D5A" />
                        <TextBlock Text="弃牌">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscardPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="›" Foreground="#4A5D5A" />
                        <TextBlock Text="结束">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhaseLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinishedPhase}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新手演练" Command="{Binding StartTutorialCommand}" ToolTip="在四段真实牌局中练习基础操作" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="武将" Command="{Binding OpenGeneralGalleryCommand}" ToolTip="浏览经典身份武将、体力与技能" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="指南" Command="{Binding ToggleHelpCommand}" ToolTip="当前操作与卡牌图鉴 · F1" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="战报 / 存档" Command="{Binding ToggleLogCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button x:Name="HistoryButton" Content="战绩" Command="{Binding OpenHistoryCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="设置" Command="{Binding OpenSettingsCommand}" Style="{StaticResource QuietButton}" Padding="10,8" />
                        <Button Content="保存" Command="{Binding SaveGameCommand}" ToolTip="保存到手动存档 · F5" Style="{StaticResource QuietButton}" />
                        <Button Content="新对局" Command="{Binding NewGameCommand}" Style="{StaticResource ToolbarButton}" Margin="12,0,0,0" Padding="15,8" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" x:Name="GameArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                    <RowDefinition Height="214" />
                    <RowDefinition Height="29" />
                </Grid.RowDefinitions>
                <Grid x:Name="Battlefield">
                    <Grid.Background>
                        <RadialGradientBrush Center=".5,.42" GradientOrigin=".5,.4" RadiusX=".75" RadiusY=".85">
                            <GradientStop Color="#30463F" Offset="0" />
                            <GradientStop Color="#14242A" Offset=".85" />
                            <GradientStop Color="#111C22" Offset="1" />
                        </RadialGradientBrush>
                    </Grid.Background>
                    <Grid IsHitTestVisible="False" Opacity="0.12" Margin="14">
                        <Border BorderBrush="#B49B66" BorderThickness="1" CornerRadius="16" Margin="0,6" />
                        <Border BorderBrush="#92825B" BorderThickness="1" CornerRadius="12" Margin="5,11" />
                        <Ellipse Stroke="#A59669" StrokeThickness="1" Margin="155,100,155,12" />
                        <Ellipse Stroke="#A59669" StrokeThickness="1" Margin="172,113,172,24" />
                        <Path Data="M0,160 Q90,60 200,130 T410,150 T630,70 T850,150 T1100,80 M0,170 Q90,70 200,140 T410,160 T630,80 T850,160 T1100,90 M0,180 Q90,80 200,150 T410,170 T630,90 T850,170 T1100,100" Stretch="Fill" Stroke="#C3AA72" StrokeThickness="0.5" Opacity=".2" Margin="10,160,10,10" />
                        <TextBlock Text="群 雄 逐 鹿" FontFamily="KaiTi" FontSize="72" Foreground="#CBB777" Opacity=".45" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,125,0,0" />
                    </Grid>
                    <Grid Margin="25,15,25,10">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="208">
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="208" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCenterChoices}" Value="True">
                                                <Setter Property="Height" Value="*" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                            <RowDefinition Height="*">
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCenterChoices}" Value="True">
                                                <Setter Property="MinHeight" Value="218" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="158" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top" Margin="2,14,0,0">
                            <TextBlock Text="{Binding TableArenaTitle}" Foreground="#D3BD8A" FontSize="12" />
                            <TextBlock Text="{Binding AliveText}" Foreground="#7F9890" FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TopSeats}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding TopSeats.Count}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="5,0">
                                        <StackPanel>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SeatTemplate}" />
                                            <TextBlock Text="{Binding SeatLabel}" Foreground="#A2AC9C" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Viewbox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,14,2,0">
                            <TextBlock Text="{Binding DeckText}" Foreground="#C8BD9F" FontSize="11" />
                            <TextBlock Text="{Binding DiscardText}" Foreground="#81978D" FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                        <Viewbox Grid.RowSpan="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,80,0,0">
                            <StackPanel>
                                <ContentControl Content="{Binding LeftPlayer}" ContentTemplate="{StaticResource SeatTemplate}" />
                                <TextBlock Text="{Binding LeftPlayer.SeatLabel}" Foreground="#A2AC9C" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.RowSpan="2" Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,80,0,0">
                            <StackPanel>
                                <ContentControl Content="{Binding RightPlayer}" ContentTemplate="{StaticResource SeatTemplate}" />
                                <TextBlock Text="{Binding RightPlayer.SeatLabel}" Foreground="#A2AC9C" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Viewbox>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="16,4" x:Name="FeedbackCenter">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0,2,0,9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCenterChoices}" Value="True">
                                                <Setter Property="Margin" Value="0,0,0,5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock x:Name="DecisionTitleText" Text="{Binding TableDecisionTitle}" FontFamily="KaiTi" Foreground="#E0C48B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDecisionContext}" Value="True">
                                                    <Setter Property="FontSize" Value="20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding CurrentPlayerText}" Foreground="#8EA49A" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="{Binding IsTableIdle, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" Visibility="{Binding IsTableIdle, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding RecentPlays}" ItemTemplate="{StaticResource TablePlayTemplate}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="运筹于帷幄之中，决胜于千里之外" FontFamily="KaiTi" Foreground="#728B7F" FontSize="15" TextAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentPlays.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            </Viewbox>
                            <Border Grid.Row="1" Background="#E2152328" BorderBrush="#776B4D" BorderThickness="1" CornerRadius="4" Padding="8" Visibility="{Binding HasCenterChoices, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="DecisionDescriptionText" Text="{Binding CurrentDecisionContext.Description}" Visibility="{Binding HasDecisionContext, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" FontSize="12" Foreground="#D1DCCB" Margin="6,1,6,8" />
                                    <ItemsControl Grid.Row="1" x:Name="PinnedPublicModuleChoices" ItemsSource="{Binding SkillChoices}" ItemTemplate="{StaticResource SkillChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" Margin="0,0,0,6" Visibility="{Binding HasPinnedPublicModuleChoices, Converter={StaticResource BoolToVisibility}}" />
                                    <ScrollViewer Grid.Row="2" x:Name="ResponseViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="760">
                                        <StackPanel>
                                            <TextBlock x:Name="PublicRevealTitleText" Text="{Binding PublicRevealTitle}" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,2,0,5" Visibility="{Binding HasPublicRevealedCards, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding PublicRevealedCards}" ItemTemplate="{StaticResource RevealedCardTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding DyingChoices}" ItemTemplate="{StaticResource DyingChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding TargetCardChoices}" ItemTemplate="{StaticResource TargetCardChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding FireAttackChoices}" ItemTemplate="{StaticResource FireAttackChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding NullificationChoices}" ItemTemplate="{StaticResource NullificationChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding ResponseChoices}" ItemTemplate="{StaticResource ResponseChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl x:Name="ScrollingSkillChoices" ItemsSource="{Binding SkillChoices}" ItemTemplate="{StaticResource SkillChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPinnedPublicModuleChoices}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                            </ItemsControl>
                                            <ItemsControl x:Name="ActiveSkillEquipmentChoices" ItemsSource="{Binding ActiveSkillEquipmentChoices}" ItemTemplate="{StaticResource ActiveSkillEquipmentChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl x:Name="EquipmentPlayChoices" ItemsSource="{Binding EquipmentPlayChoices}" ItemTemplate="{StaticResource EquipmentPlayChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding PublicTargetChoices}" ItemTemplate="{StaticResource PublicTargetChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                            <ItemsControl ItemsSource="{Binding TargetCombinationChoices}" ItemTemplate="{StaticResource TargetCombinationChoiceTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                <Border x:Name="ActionBar" Grid.Row="1" Background="#17262B" BorderBrush="#595A47" BorderThickness="0,1,0,1" Padding="25,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsTutorialActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ActionHint}" Foreground="#E9D5A9" FontSize="14" TextWrapping="Wrap" MaxHeight="39" />
                                <TextBlock Text="点击手牌 → 选择目标 → 确认出牌" Foreground="#7F9A91" FontSize="10" Margin="0,3,0,0" Visibility="{Binding CanEndTurn, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Grid x:Name="TutorialActionPanel" Visibility="{Binding IsTutorialActive, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="新手演练" Foreground="#D2AF69" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TutorialProgress, StringFormat= · {0}}" Foreground="#82998D" Margin="4,0,0,0" />
                                        <TextBlock x:Name="TutorialTitleText" Text="{Binding TutorialTitle, StringFormat= · {0}}" Foreground="#EAD6AA" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TutorialInstruction}" Foreground="#A9BCAD" FontSize="11" TextWrapping="Wrap" MaxHeight="34" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="重来" Command="{Binding RestartTutorialStepCommand}" Style="{StaticResource QuietButton}" Padding="8,6" />
                                    <Button x:Name="TutorialNextButton" Content="{Binding TutorialNextText}" Command="{Binding NextTutorialStepCommand}" Style="{StaticResource PrimaryButton}" Padding="11,7" Visibility="{Binding IsTutorialStepComplete, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding TutorialExitText}" Command="{Binding ExitTutorialCommand}" Style="{StaticResource QuietButton}" Padding="8,6" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsTutorialBoardEnabled}">
                            <Button Content="操作提示" Command="{Binding OpenContextGuideCommand}" Style="{StaticResource QuietButton}" Padding="10,8" ToolTip="查看操作说明与出牌建议 · F1" />
                            <ItemsControl x:Name="NationalRevealButtons" ItemsSource="{Binding NationalRevealChoices}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Description}" Command="{Binding DataContext.RevealNationalGeneralCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Padding="9,8" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
