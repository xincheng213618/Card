                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding DataContext.SelectBattleLogCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource SelectedFilterButton}" Padding="7,4" FontSize="10"><Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Id" /><Binding Path="DataContext.SelectedBattleLogCategory" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Button.Tag></Button></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5,5,5,0">
                                        <ItemsControl ItemsSource="{Binding BattleLogSeats}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding DataContext.SelectBattleLogSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource SelectedFilterButton}" Padding="7,4" FontSize="10"><Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Id" /><Binding Path="DataContext.SelectedBattleLogSeat" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Button.Tag></Button></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Grid.Row="2" Text="{Binding BattleLogFilterSummary}" Foreground="#789083" FontSize="10" Margin="9,6,5,4" />
                                    <ListBox x:Name="FilteredBattleLogList" Grid.Row="3" ItemsSource="{Binding FilteredBattleLog}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,4">
                                                    <TextBlock Text="{Binding Header}" Foreground="#8EA597" FontSize="9" />
                                                    <TextBlock Text="{Binding Message}" Foreground="#D6D8C8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="AI 思考" Visibility="{Binding IsDeveloperView, Converter={StaticResource BoolToVisibility}}">
                                <ListBox ItemsSource="{Binding AiThoughts}" />
                            </TabItem>
                            <TabItem Header="事件栈" Visibility="{Binding IsDeveloperView, Converter={StaticResource BoolToVisibility}}">
                                <ListBox ItemsSource="{Binding EventStack}" />
                            </TabItem>
                        </TabControl>
                        <StackPanel Grid.Row="3" Margin="0,15,0,0">
                            <Separator Background="#59634D" />
                            <CheckBox Content="开发者视图（显示隐藏信息）" IsChecked="{Binding IsDeveloperView}" Margin="0,14,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="AI 单步" Command="{Binding StepAiCommand}" Style="{StaticResource ToolbarButton}" />
                                <Button Content="运行至我行动" Command="{Binding RunToHumanCommand}" Style="{StaticResource ToolbarButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="IdentityRevealOverlay" Background="#F20A1419" Visibility="{Binding IsIdentityRevealOpen, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="IdentityRevealOverlay_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
            <Border Width="590" Padding="40,34" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#19282D" BorderBrush="#A98A50" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="{Binding IdentityRevealTitle}" FontFamily="KaiTi" FontSize="25" Foreground="#BDA56F" HorizontalAlignment="Center" />
                    <Border Width="178" Height="178" Margin="0,22,0,18" HorizontalAlignment="Center" Background="#101D22" BorderBrush="#C09B57" BorderThickness="2" CornerRadius="89">
                        <Grid>
                            <Ellipse Margin="9" Stroke="#66583D" StrokeThickness="1" />
                            <TextBlock Text="{Binding IdentityRevealRole}" FontFamily="KaiTi" FontSize="49" FontWeight="Bold" Foreground="#F3D18E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding IdentityObjective}" FontFamily="KaiTi" FontSize="21" Foreground="#E3D0A2" TextAlignment="Center" TextWrapping="Wrap" LineHeight="30" />
                    <TextBlock Text="{Binding IdentityRevealRoster}" Foreground="#91A99B" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <Border Background="#112127" BorderBrush="#465C53" BorderThickness="1" Padding="12,8" Margin="36,20,36,0">
                        <TextBlock Text="身份与目标仅在本机向你展示；其他暗置信息仍由引擎保护。" Foreground="#82968A" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="ContinueFromIdentityRevealButton" Content="查 看 候 选 武 将" Command="{Binding ContinueFromIdentityRevealCommand}" Style="{StaticResource PrimaryButton}" MinWidth="190" Padding="20,10" HorizontalAlignment="Center" Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="NewGameSetupPanel" Background="#ED0C151A" Visibility="{Binding IsNewGameSetupOpen, Converter={StaticResource BoolToVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" IsVisibleChanged="NewGameSetupPanel_IsVisibleChanged" FocusManager.IsFocusScope="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHelpOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsHistoryOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsGeneralGalleryOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <controls:HomeLobby x:Name="LobbyHome">
                    <controls:HomeLobby.Style>
                        <Style TargetType="controls:HomeLobby">
                            <Style.Triggers><DataTrigger Binding="{Binding IsLobbyConfigurationOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                        </Style>
                    </controls:HomeLobby.Style>
                </controls:HomeLobby>
                <Border x:Name="LobbyConfigurationOverlay" Background="#D9191818" Visibility="{Binding IsLobbyConfigurationOpen, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="NewGameSetupPanel_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
            <Border Width="790" Background="#1A282D" BorderBrush="#A28750" BorderThickness="1" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="返回大厅" Command="{Binding BackToLobbyCommand}" Style="{StaticResource ToolbarButton}" MinWidth="130" />
                            <Button x:Name="StartNewGameButton" Content="开 始 对 局" Command="{Binding StartNewGameFromLobbyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170" />
                        </StackPanel>
                        <TextBlock Text="开始新对局会替换当前对局；返回大厅可保留当前进度。" Foreground="#778E80" FontSize="10" HorizontalAlignment="Center" Margin="0,13,0,0" />
                    </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="开 局 布 阵" FontFamily="KaiTi" FontSize="34" Foreground="#F1D298" HorizontalAlignment="Center" />
                        <TextBlock Text="选择战场与身份或阵营，开启一场新的较量" Foreground="#9BAC9F" FontSize="12" HorizontalAlignment="Center" Margin="0,9,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button x:Name="SetupTutorialButton" Content="四步新手演练" Command="{Binding StartTutorialCommand}" Style="{StaticResource PrimaryButton}" Padding="17,9" />
                            <Button Content="先看战局指南" Command="{Binding OpenContextGuideCommand}" Style="{StaticResource QuietButton}" Padding="14,9" />
                            <Button x:Name="ConfigurationHistoryButton" Content="历史战绩" Command="{Binding OpenHistoryCommand}" Style="{StaticResource QuietButton}" Padding="14,9" />
                        </StackPanel>
                        <TextBlock Text="{Binding TutorialEntryError}" Visibility="{Binding HasTutorialEntryError, Converter={StaticResource BoolToVisibility}}" Foreground="#E5A396" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <Border Visibility="{Binding HasAnySave, Converter={StaticResource BoolToVisibility}}" Background="#142227" BorderBrush="#53624E" BorderThickness="1" Padding="12,9" Margin="4,0,4,18">
                            <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="续 接 战 局" FontFamily="KaiTi" FontSize="20" Foreground="#E6C58C" />
                                    <TextBlock Text="{Binding AutomaticSaveText}" Foreground="#879C8D" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="继续上次对局" Command="{Binding ContinueGameCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding HasAutomaticSave, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" Padding="16,8" />
                                <Button Grid.Column="2" Content="读取手动存档" Command="{Binding LoadManualGameCommand}" Style="{StaticResource ToolbarButton}" Visibility="{Binding HasManualSave, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" Padding="12,8" ToolTip="{Binding ManualSaveText}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SessionSaveStatus}" Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" Foreground="#E5A396" Margin="4,0,4,12" />
                        <DockPanel Margin="4,0,4,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ModeLobbySummary}" Foreground="#758D82" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="模式大厅" Foreground="#CFB985" FontSize="13" />
                        </DockPanel>
                        <ListBox x:Name="ModeCategoryChoices" ItemsSource="{Binding ModeCategories}" SelectedItem="{Binding SelectedModeCategory}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" AutomationProperties.Name="模式分类">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="#93A99C" /><Setter Property="Padding" Value="15,6" /><Setter Property="Margin" Value="0,0,5,0" /><Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryFrame" Background="#142329" BorderBrush="#40534B" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryFrame" Property="Background" Value="#8B7042" /><Setter TargetName="CategoryFrame" Property="BorderBrush" Value="#D2B46F" /><Setter Property="Foreground" Value="#FFF0C8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <ListBox x:Name="TableModeChoices" ItemsSource="{Binding VisibleTableModes}" SelectedItem="{Binding SelectedTableMode}" ItemContainerStyle="{StaticResource SetupChoiceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="选择对局模式">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,5">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PlayerCountText}" Foreground="#789083" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="17" Foreground="#E6C58C" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ModeBadge}" Foreground="#B39A65" FontSize="9" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Description}" Foreground="#9FAF9F" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Visibility="{Binding IsClassicIdentityModeSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="牌堆扩展" Foreground="#CFB985" FontSize="13" Margin="4,16,0,8" />
                            <ListBox x:Name="DeckChoices" ItemsSource="{Binding DeckOptions}" SelectedItem="{Binding SelectedDeck}" ItemContainerStyle="{StaticResource SetupChoiceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="选择牌堆扩展">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,5">
                                            <TextBlock Text="{Binding Name}" FontSize="17" Foreground="#E6C58C" />
                                            <TextBlock Text="{Binding Description}" Foreground="#9FAF9F" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding DeckSetupText}" Foreground="#80998C" FontSize="10" Margin="8,5,8,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding SetupIdentityLabel}" Foreground="#CFB985" FontSize="13" Margin="4,16,0,8" />
                        <ListBox x:Name="RoleChoices" ItemsSource="{Binding StartingRoles}" SelectedItem="{Binding SelectedStartingRole}" ItemContainerStyle="{StaticResource SetupChoiceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsIdentityModeSelection, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6" Height="73">
                                        <TextBlock Text="{Binding Name}" Foreground="#E6C58C" FontSize="20" FontFamily="KaiTi" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Description}" Foreground="#9FAF9F" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox x:Name="TeamChoices" ItemsSource="{Binding StartingTeams}" SelectedItem="{Binding SelectedStartingTeam}" ItemContainerStyle="{StaticResource SetupChoiceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsTeamModeSelection, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="选择你的队伍">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,5">
                                        <TextBlock Text="{Binding Name}" FontFamily="KaiTi" FontSize="22" Foreground="#E6C58C" />
                                        <TextBlock Text="{Binding Description}" Foreground="#9FAF9F" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Visibility="{Binding IsTeamModeSelection, Converter={StaticResource BoolToVisibility}}" Background="#142A31" BorderBrush="#4C806D" BorderThickness="1" Padding="12,8" Margin="4,8,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TeamModeSetupText}" Foreground="#9FAF9F" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <CheckBox Content="自己选择回合末弃牌" IsChecked="{Binding ManualDiscardEnabled}" Margin="8,16,0,7" />
                        <TextBlock Text="{Binding NationalSetupText}" Visibility="{Binding IsNationalModeSelection, Converter={StaticResource BoolToVisibility}}" Foreground="#AEC0A9" FontSize="12" TextWrapping="Wrap" Margin="8,2,8,10" />
                        <TextBlock Text="开启后，手牌超过体力时由你决定保留哪些牌。AI 自动行动，并在需要你出牌、弃牌或响应时暂停。" Foreground="#7F9B8B" TextWrapping="Wrap" LineHeight="20" FontSize="11" Margin="8,0,8,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <CheckBox x:Name="SetupSoundToggle" Content="游戏声音" IsChecked="{Binding IsSoundEnabled}" VerticalAlignment="Center" ToolTip="{Binding SoundStatusText}" />
                            <Slider x:Name="SetupSoundVolume" Value="{Binding SoundVolume}" Minimum="0" Maximum="1" Width="110" IsEnabled="{Binding IsSoundEnabled}" VerticalAlignment="Center" Margin="12,0,24,0" AutomationProperties.Name="开局音量" ToolTip="{Binding SoundStatusText}" />
                            <CheckBox x:Name="SetupMotionToggle" Content="动画效果" IsChecked="{Binding IsMotionEnabled}" VerticalAlignment="Center" />
                            <TextBlock Text="下次启动沿用设置" Foreground="#80998C" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0" />
                        </StackPanel>
                        <DockPanel Margin="8,8,8,0" Visibility="{Binding HasPreferencesError, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="重试设置" Command="{Binding RetryPreferencesCommand}" Style="{StaticResource QuietButton}" Padding="10,4" />
                            <TextBlock Text="{Binding PreferencesStatus}" Foreground="#D5AA85" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="PlayerGuideOverlay" Background="#ED0B151A" Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="PlayerGuideOverlay_IsVisibleChanged">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsHistoryOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding IsGeneralGalleryOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <controls:PlayerGuidePanel x:Name="PlayerGuide" />
        </Border>
        <Border x:Name="GeneralGalleryOverlay" Background="#D10B1114" Visibility="{Binding IsGeneralGalleryOpen, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="GeneralGalleryOverlay_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
            <controls:GeneralGalleryPanel x:Name="GeneralGallery" />
        </Border>
        <Border x:Name="HistoryOverlay" Background="#ED0B151A" Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="HistoryOverlay_IsVisibleChanged">
            <controls:MatchHistoryPanel x:Name="HistoryPanel" />
        </Border>
        <Border x:Name="SettingsOverlay" Background="#ED0B151A" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="SettingsOverlay_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
            <Border x:Name="SettingsPanel" Width="680" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F414242A" BorderBrush="#9A8158" BorderThickness="1" CornerRadius="5" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Content="返回牌桌" Command="{Binding CloseSettingsCommand}" Style="{StaticResource ToolbarButton}" Padding="15,8" />
                        <StackPanel>
                            <TextBlock Text="牌 局 设 置" FontFamily="KaiTi" FontSize="28" Foreground="#E8CA8D" />
                            <TextBlock Text="辅助表现独立于规则结算；调整后不会替你选牌或提交行动。" Foreground="#8EA397" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#18282D" BorderBrush="#506258" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="基础表现" FontFamily="KaiTi" FontSize="20" Foreground="#DFC081" />
                                <TextBlock Text="保存在本机" Foreground="#72887D" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="SettingsSoundToggle" Content="游戏声音" IsChecked="{Binding IsSoundEnabled}" />
                                <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,10,0,0" ToolTip="游戏音量" />
                                <TextBlock Text="{Binding SoundStatusText}" Foreground="#879C90" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="SettingsMusicToggle" Content="背景音乐" IsChecked="{Binding IsMusicEnabled}" Margin="0,0,20,0" />
                                    <CheckBox x:Name="SettingsVoiceToggle" Content="武将配音" IsChecked="{Binding IsVoiceEnabled}" />
                                </WrapPanel>
                                <CheckBox x:Name="SettingsMotionToggle" Content="动画与战场反馈" IsChecked="{Binding IsMotionEnabled}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="#18282D" BorderBrush="#506258" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="对局节奏" FontFamily="KaiTi" FontSize="20" Foreground="#DFC081" />
                                <TextBlock Text="随当前存档恢复" Foreground="#72887D" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="SettingsAutoAdvanceToggle" Content="自动推进其他角色行动" IsChecked="{Binding IsAutoAdvance}" />
                                <ListBox x:Name="SettingsPlaybackSpeedSelector" ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding SelectedPlaybackSpeed}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,0" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Foreground" Value="#B6C8B8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SettingsPaceFrame" Background="#233237" BorderBrush="#52635A" BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="2,0"><ContentPresenter HorizontalAlignment="Center" /></Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="SettingsPaceFrame" Property="Background" Value="#AB8B4E" /><Setter Property="Foreground" Value="#171E19" /></Trigger>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SettingsPaceFrame" Property="BorderBrush" Value="#FFE2A0" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock Text="只改变自动行动的等待时间；轮到你出牌、响应或选择时仍会停下。" Foreground="#879C90" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" BorderBrush="#4B5D54" BorderThickness="1,0,0,0" Padding="14,0,0,0" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="输入与隐私" FontFamily="KaiTi" FontSize="18" Foreground="#D3B97F" />
                            <TextBlock Text="Esc 关闭面板 · F1 打开指南 · F5 手动存档 · Ctrl+M 静音" Foreground="#9AADA2" FontSize="11" Margin="0,6,0,0" />
                            <TextBlock Text="设置只读取本方已知状态；不会展示暗置身份、其他角色手牌或 AI 私有判断。" Foreground="#71877B" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
