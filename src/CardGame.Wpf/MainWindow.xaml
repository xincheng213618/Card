                                                            <ItemsControl x:Name="PrivateTurnHandHoldCards" ItemsSource="{Binding PrivateCards}" ItemTemplate="{StaticResource RevealedCardTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                                        </Expander>
