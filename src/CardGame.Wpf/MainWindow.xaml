                                    <ItemsControl x:Name="NamedPrivatePiles" ItemsSource="{Binding NamedPrivatePiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#81735E" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,5,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource GoldBrush}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PrivacyHint}" Foreground="#D1DCCB" FontSize="10" Margin="0,4,0,4" TextWrapping="Wrap" />
                                                        <ItemsControl x:Name="NamedPrivatePileEntries" ItemsSource="{Binding Entries}" Visibility="{Binding HasPrivateEntries, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Width="90" Margin="0,3">
                                                                        <TextBlock x:Name="NamedPrivatePileRecordedName" Text="{Binding RecordedName}" Foreground="{StaticResource GoldBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                                                                        <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource RevealedCardTemplate}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
