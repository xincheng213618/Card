                                        <DataTemplate>
                                            <Border BorderBrush="#81735E" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,5,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource GoldBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PublicDeclaration}" Foreground="#D1DCCB" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Attributes}" Foreground="#D1DCCB" FontSize="11" Margin="0,3,0,0" />
                                                    <Expander x:Name="PrivateGeneralLibraryDetails" Header="{Binding PrivateTitle}" Foreground="{StaticResource GoldBrush}" Margin="0,6,0,0" Visibility="{Binding HasPrivateAvatars, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl x:Name="PrivateGeneralAvatars" ItemsSource="{Binding PrivateAvatars}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Width="72" Margin="2,4">
                                                                        <Image Source="{Binding Portrait.Image}" Width="64" Height="81" Stretch="Uniform" />
                                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#D1DCCB" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Expander>
                            <TextBlock Text="对 局 控 制" Foreground="#D1B98F" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Button x:Name="ContinueAdvanceButton" Content="继续推进" Command="{Binding RunToHumanCommand}" IsEnabled="{Binding IsTutorialBoardEnabled}" HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip="推进到下一次需要你出牌或响应时停下。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanStepAi}" Value="True" />
                                                    <Condition Binding="{Binding IsAutoAdvance}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <CheckBox Content="自动推进" IsChecked="{Binding IsAutoAdvance}" ToolTip="每次推进一步，在需要你出牌或响应时自动停下。" HorizontalAlignment="Center" />
                            <ListBox x:Name="PlaybackSpeedSelector" ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding SelectedPlaybackSpeed}" Width="108" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center" ToolTip="对局速度：调整自动推进和战斗动画的节奏；需要你操作时会停下。" AutomationProperties.Name="对局速度" PreviewMouseLeftButtonDown="RequiredSetupChoice_PreviewMouseLeftButtonDown" PreviewKeyDown="RequiredSetupChoice_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="#B6C8B8" />
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="PaceFrame" Background="#233237" BorderBrush="#52635A" BorderThickness="1" CornerRadius="2" Padding="3,4" Margin="1,0">
                                                        <ContentPresenter HorizontalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="PaceFrame" Property="Background" Value="#AB8B4E" />
                                                            <Setter Property="Foreground" Value="#171E19" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="PaceFrame" Property="BorderBrush" Value="#FFE2A0" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <CheckBox Content="动画效果" IsChecked="{Binding IsMotionEnabled}" Margin="0,6,0,0" HorizontalAlignment="Center" ToolTip="显示飞牌、目标和伤害反馈；可关闭动态效果。" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="{Binding SoundStatusText}">
                                <CheckBox x:Name="SoundToggle" Content="声音" IsChecked="{Binding IsSoundEnabled}" VerticalAlignment="Center" />
                                <Slider x:Name="SoundVolumeSlider" Width="64" Margin="6,0,0,0" Minimum="0" Maximum="1" Value="{Binding SoundVolume}" IsEnabled="{Binding IsSoundEnabled}" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="游戏音量" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <WrapPanel x:Name="SupplementalActionBar" Grid.Row="0" Margin="8,0,8,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsEnabled="{Binding IsTutorialBoardEnabled}">
                    <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding HasTargetCardPicker}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                    <ItemsControl x:Name="NationalRevealButtons" ItemsSource="{Binding NationalRevealChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Description}" Command="{Binding DataContext.RevealNationalGeneralCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource TableSecondaryButton}" Padding="9,8" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="FastSpectateButton" Content="快速观战" Command="{Binding FastSpectateCommand}" Style="{StaticResource TablePrimaryButton}" Visibility="{Binding IsSpectating, Converter={StaticResource BoolToVisibility}}" ToolTip="以快速节奏观看剩余对局，取消自动推进可暂停。" />
                    <Button x:Name="RecastButton" Content="重铸换牌" Command="{Binding RecastSelectedCommand}" Style="{StaticResource TableSecondaryButton}" Visibility="{Binding ShowRecastAction, Converter={StaticResource BoolToVisibility}}" ToolTip="不选目标时可重铸所选牌，将其置入弃牌堆并摸一张牌；不会进入无懈响应。" />
                    <Button Content="{Binding AlternatePlayText}" Command="{Binding PlaySelectedAsSlashCommand}" Style="{StaticResource TableSecondaryButton}" Visibility="{Binding HasAlternateSlash, Converter={StaticResource BoolToVisibility}}" ToolTip="按当前技能把所选实体牌转换为对应的有效牌型。" />
                    <ItemsControl ItemsSource="{Binding SupplementalActiveSkillActions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Description}" Command="{Binding DataContext.SelectActiveSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource TableSecondaryButton}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <Border x:Name="ActionBar" Grid.Row="1" Background="Transparent" Padding="8,5,8,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="90" /><Style.Triggers><DataTrigger Binding="{Binding IsWushuangShopOpen}" Value="True"><Setter Property="Opacity" Value="0" /></DataTrigger><DataTrigger Binding="{Binding SelectionArea.HasCatalogChoices}" Value="True"><Setter Property="Height" Value="250" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid>
                        <!-- Supplemental actions float above this fixed dock instead of resizing the battlefield. -->
                        <Grid.RowDefinitions><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding SelectionArea.HasCatalogChoices}" Value="True"><Setter Property="Height" Value="160" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition><RowDefinition Height="23" /><RowDefinition Height="48" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" x:Name="CardNameSelectionArea" Background="#EC211E19" BorderBrush="#8B7750" BorderThickness="1" CornerRadius="4" Padding="6,3" Visibility="{Binding SelectionArea.HasCatalogChoices, Converter={StaticResource BoolToVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding SelectionArea.CatalogTitle}" Foreground="#E3C58A" FontFamily="KaiTi" FontSize="16" Margin="6,0" />
                                <ScrollViewer Grid.Row="1" x:Name="CardNameSelectionViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="CardNameSelectionChoices" ItemsSource="{Binding SelectionArea.CatalogChoices}" ItemTemplate="{StaticResource CardNameSelectionTemplate}" ItemsPanel="{StaticResource ChoicePanel}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="6,0,6,3">
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsTutorialActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock x:Name="ActionDockHint" Text="{Binding SelectionArea.Hint}" ToolTip="{Binding SelectionArea.Hint}" Foreground="#FFF7E7" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNullificationSelectionPending}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsGeneralLibrarySelectionPending}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsDiscardSelectionPending}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Effect><DropShadowEffect Color="#1A130D" BlurRadius="3" ShadowDepth="1" /></TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                            <Grid x:Name="TutorialActionPanel" Visibility="{Binding IsTutorialActive, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="新手演练" Foreground="#D2AF69" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TutorialProgress, StringFormat= · {0}}" Foreground="#82998D" Margin="4,0,0,0" />
                                        <TextBlock x:Name="TutorialTitleText" Text="{Binding TutorialTitle, StringFormat= · {0}}" Foreground="#EAD6AA" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TutorialInstruction}" Foreground="#A9BCAD" FontSize="11" TextWrapping="Wrap" MaxHeight="34" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="重来" Command="{Binding RestartTutorialStepCommand}" Style="{StaticResource QuietButton}" Padding="8,6" />
                                    <Button x:Name="TutorialNextButton" Content="{Binding TutorialNextText}" Command="{Binding NextTutorialStepCommand}" Style="{StaticResource TablePrimaryButton}" Padding="11,7" Visibility="{Binding IsTutorialStepComplete, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding TutorialExitText}" Command="{Binding ExitTutorialCommand}" Style="{StaticResource QuietButton}" Padding="8,6" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                        <Grid x:Name="PrimaryActionButtons" Width="450" HorizontalAlignment="Center" IsEnabled="{Binding IsTutorialBoardEnabled}">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding SelectionArea.ShowPrimaryButtons}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="PlayCardButton" Content="{Binding SelectionArea.ConfirmText}" Command="{Binding SelectionArea.ConfirmCommand}" IsEnabled="{Binding SelectionArea.CanConfirm}" Style="{StaticResource TablePrimaryButton}" MinWidth="104" HorizontalAlignment="Center" Visibility="{Binding SelectionArea.ShowConfirm, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding SelectionArea.ConfirmText}" AutomationProperties.Name="{Binding SelectionArea.ConfirmText}" />
                            <Button x:Name="CancelActionButton" Content="{Binding SelectionArea.CancelText}" Command="{Binding SelectionArea.CancelCommand}" IsEnabled="{Binding SelectionArea.CanCancel}" Width="104" HorizontalAlignment="Center" Visibility="{Binding SelectionArea.ShowConfirm, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding CancelActionHint}" AutomationProperties.Name="{Binding SelectionArea.CancelText}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TableSecondaryButton}"><Setter Property="Grid.Column" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsDiscardSelectionPending}" Value="True"><Setter Property="Grid.Column" Value="2" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button x:Name="EndTurnButton" Grid.Column="2" Content="结 束" Command="{Binding EndTurnCommand}" Style="{StaticResource TableSecondaryButton}" Width="84" HorizontalAlignment="Center" Visibility="{Binding SelectionArea.ShowEndTurn, Converter={StaticResource BoolToVisibility}}" ToolTip="结束出牌 · Ctrl + Enter" AutomationProperties.Name="结束出牌" />
                            <Button x:Name="RecommendDiscardButton" Grid.Column="1" Content="推荐弃牌" Command="{Binding RecommendDiscardCommand}" Style="{StaticResource TableSecondaryButton}" MinWidth="104" HorizontalAlignment="Center" Visibility="{Binding IsDiscardSelectionPending, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="推荐弃牌" />
                        </Grid>
                            <ItemsControl x:Name="DockSkillChoices" ItemsSource="{Binding SelectionArea.Choices}" Visibility="{Binding SelectionArea.HasChoices, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Description}" Command="{Binding DataContext.SelectionArea.ChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource TableSecondaryButton}" Margin="5,0" Padding="16,5" FontSize="14" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}" />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Viewbox>
                        <Image x:Name="PlayPhaseMarker" Grid.Row="3" Source="pack://application:,,,/CardGame.Wpf;component/Assets/Table/seat__SeatRoundState_4.png" Width="140" Height="14" HorizontalAlignment="Left" Margin="146,0,0,0" Stretch="Fill" Visibility="{Binding CanEndTurn, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
                        <Border x:Name="OpeningHandControls" Grid.RowSpan="4" Background="#2C2117" Padding="8,3" Visibility="{Binding CanRerollOpeningHand, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="TableOverlay_IsVisibleChanged">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="RerollOpeningHandButton" Content="随 机" Command="{Binding RerollOpeningHandCommand}" Style="{StaticResource ToolbarButton}" Padding="16,5" ToolTip="将起手牌放回牌堆，重新随机同样数量的手牌" />
                                        <Button x:Name="ChangeOpeningHandButton" Content="换 牌" Command="{Binding ToggleOpeningHandEditorCommand}" Style="{StaticResource ToolbarButton}" Padding="16,5" Margin="8,0" ToolTip="点选一张手牌，按牌名选择想换入的牌" />
                                        <Button x:Name="ConfirmOpeningHandButton" Content="确 定" Command="{Binding DismissOpeningDealCommand}" Style="{StaticResource PrimaryButton}" Padding="16,5" ToolTip="确认当前手牌，进入牌局" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OpeningHandHint}" Foreground="#F0D08F" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Grid Margin="0,5,0,0" Visibility="{Binding IsOpeningHandEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="搜索牌名" Foreground="#C8B48D" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="OpeningCardSearchBox" Grid.Column="1" Text="{Binding OpeningCardSearch, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" ToolTip="例如：丈八、诸葛连弩" AutomationProperties.Name="搜索起手牌牌名" />
                                    <ComboBox x:Name="OpeningCardSelector" Grid.Column="2" ItemsSource="{Binding OpeningCardChoices}" SelectedItem="{Binding SelectedOpeningCardChoice}" DisplayMemberPath="Name" Margin="8,0" MinWidth="100" MaxDropDownHeight="240" AutomationProperties.Name="选择换入的牌" />
                                    <Button x:Name="ReplaceOpeningCardButton" Grid.Column="3" Content="换入手牌" Command="{Binding ReplaceOpeningCardCommand}" Style="{StaticResource ToolbarButton}" Padding="12,3" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="HandDock" Grid.Row="2" Grid.ColumnSpan="2" Background="#2C2117" BorderBrush="#84725B" BorderThickness="0,1,0,0" Padding="8,6">
                    <Grid>
                        <Grid.Background><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/seatbottom__grade_cover_4.png" Stretch="Fill" /></Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EquipmentRailColumn" Width="154" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="HumanSkillColumn" Width="Auto" />
                            <ColumnDefinition x:Name="HumanPortraitColumn" Width="142" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="EquipmentRail" Margin="0,0,8,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="装 备" Foreground="#C8B48D" FontFamily="KaiTi" FontSize="12" Margin="3,0,0,5" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="本方装备区">
                                <ItemsControl x:Name="HumanEquipmentSlots" ItemsSource="{Binding HumanEquipmentSlots}" ItemTemplate="{StaticResource EquipmentSlotTemplate}">
                                    <ItemsControl.LayoutTransform><ScaleTransform ScaleX="{DynamicResource EquipmentControlScale}" ScaleY="{DynamicResource EquipmentControlScale}" /></ItemsControl.LayoutTransform>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <Grid Grid.Column="1" Margin="8,0">
                            <controls:HandScrollViewer x:Name="HandViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" ToolTip="按住手牌拖向亮起的武将，松开出牌；多目标牌松开选定目标后继续确认。滚轮浏览手牌，双击确认，右键取消选择。" AutomationProperties.Name="手牌浏览区">
                                <ItemsControl x:Name="HandCards" ItemsSource="{Binding Hand}" ItemTemplate="{StaticResource CardTemplate}" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:HandPanel ViewportWidth="{Binding ActualWidth, ElementName=HandViewport}" HandSnapshot="{Binding ChoiceSnapshot}" PlaybackTimeScale="{Binding BattleAnimationTimeScale}" ArrivalTimeline="{Binding ArrivalTimeline, ElementName=BattleFeedback}">
                                                <controls:HandPanel.Style>
                                                    <Style TargetType="controls:HandPanel">
                                                        <Setter Property="ArrivalEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpeningDealVisible}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsGeneralSelectionPending}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding HasGameOver}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHistoryOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsGeneralGalleryOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHelpOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNewGameSetupOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsIdentityRevealOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLogOpen}" Value="True"><Setter Property="ArrivalEnabled" Value="False" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:HandPanel.Style>
                                            </controls:HandPanel>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="controls:HandScrollViewer.RevealSelection" Value="{Binding IsSelected}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Panel.ZIndex" Value="50" />
                                                </DataTrigger>
                                                <Trigger Property="controls:HandPanel.IsPointerCard" Value="True">
                                                    <Setter Property="Panel.ZIndex" Value="100" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Panel.ZIndex" Value="75" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </controls:HandScrollViewer>
                        </Grid>

                        <Border x:Name="HumanSkillSpace" Grid.Column="2" Margin="3,0,5,0" Width="{Binding HumanSkillRailWidth}" IsHitTestVisible="False">
