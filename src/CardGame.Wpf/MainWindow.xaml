                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#746246" BorderThickness="1,0,0,0" Padding="14,0,0,0" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="输入与隐私" FontFamily="KaiTi" FontSize="18" Foreground="#D3B97F" />
                            <TextBlock Text="Esc 返回 · Tab 切换控件 · 空格切换复选框 · 聚焦音量后按左右方向键调整 · Ctrl+M 开关声音" Foreground="#D6C5A7" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="SettingsPrivacyNotice" Text="设置只读取本方已知状态；不会展示暗置身份、其他角色手牌或 AI 私有判断。" Foreground="#BCA98A" FontSize="11" Margin="0,7,0,2" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                      </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
        <Border x:Name="ShanheOverlay" Background="#F00B1519" Panel.ZIndex="300" Visibility="{Binding IsShanheOpen, Converter={StaticResource BoolToVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True" IsVisibleChanged="TableOverlay_IsVisibleChanged">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><controls:ShanheCampaignPanel x:Name="ShanhePanel" /></Viewbox>
        </Border>
        <Border x:Name="WushuangShopOverlay" Background="#9A120D08" Panel.ZIndex="310" Visibility="{Binding IsWushuangShopOpen, Converter={StaticResource BoolToVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True" IsVisibleChanged="TableOverlay_IsVisibleChanged">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="{Binding ActualWidth, ElementName=TableSidebar}" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding ActualHeight, ElementName=TableHeader}" />
                    <RowDefinition />
                    <RowDefinition Height="{Binding ActualHeight, ElementName=HandDock}" />
                    <RowDefinition Height="{Binding ActualHeight, ElementName=TableStatusBar}" />
                </Grid.RowDefinitions>
                <Viewbox x:Name="WushuangShopViewport" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="10,6"><controls:WushuangShopPanel x:Name="WushuangShopPanel" /></Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
