<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CardGame.Wpf.Controls" xmlns:core="clr-namespace:CardGame.Core;assembly=CardGame.Core">
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:SelectionMatchConverter x:Key="SelectionMatch" />
    <SolidColorBrush x:Key="PaperBrush" Color="#EFE3C8" />
    <SolidColorBrush x:Key="MutedPaperBrush" Color="#A8A99C" />
    <SolidColorBrush x:Key="GoldBrush" Color="#D8B778" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#90C5AB" />
    <SolidColorBrush x:Key="TableDeepBrush" Color="#10191C" />
    <SolidColorBrush x:Key="LineBrush" Color="#455150" />
    <LinearGradientBrush x:Key="CardPaper" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAF1D9" Offset="0" />
        <GradientStop Color="#D9C9A7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PortraitShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0010181C" Offset="0.28" />
        <GradientStop Color="#7010181C" Offset="0.55" />
        <GradientStop Color="#FF10181C" Offset="1" />
    </LinearGradientBrush>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F51A262B" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="#86724E" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="MaxWidth" Value="350" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="22" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Background" Value="#263437" />
        <Setter Property="BorderBrush" Value="#59615A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                    <Grid x:Name="InteractionSurface" IsHitTestVisible="False" controls:InteractionMotion.IsEnabled="True"
                          controls:InteractionMotion.HoverOffset="-1">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="HoverWash" Background="#12FFE0A0" CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="FocusRing" BorderBrush="#FFE8AC" BorderThickness="1" CornerRadius="3" Margin="3" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#E2C48B" />
                            <Setter TargetName="HoverWash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#F9DEA2" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Foreground" Value="#251F15" />
        <Setter Property="BorderBrush" Value="#F0D49A" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E8CA8B" Offset="0" />
                    <GradientStop Color="#B6975C" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#B8B9A9" />
    </Style>
    <Style x:Key="SelectedFilterButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Background" Value="#39463E" />
                <Setter Property="BorderBrush" Value="#C4A76D" />
                <Setter Property="Foreground" Value="#F2D69A" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PhaseLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6E7E7E" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="11,0" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource MutedPaperBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#C6C8BC" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="5,8" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedPaperBrush}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="NationalGeneralSlotTemplate">
        <Grid ClipToBounds="True" ToolTip="{Binding DetailText}" ToolTipService.InitialShowDelay="300">
            <Rectangle Fill="{Binding Portrait.Brush}" />
            <TextBlock x:Name="HiddenSlotGlyph" Text="暗" Foreground="#817556" FontSize="26" FontFamily="KaiTi" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,45" />
            <Rectangle Fill="{StaticResource PortraitShade}" />
            <StackPanel VerticalAlignment="Bottom" Margin="3,0,3,52" Background="#BD102022">
                <TextBlock x:Name="SlotGeneralName" Text="{Binding Name}" Foreground="#FFE9BD" FontFamily="KaiTi" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SlotRevealState" Text="{Binding SlotState}" Foreground="{Binding StateBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,1" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasPortrait}" Value="True">
                <Setter TargetName="HiddenSlotGlyph" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="TablePrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="16,5" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/selfseat__selfSeatOkBtn_normal.png" Stretch="Fill" /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                    <Grid x:Name="TableInteractionSurface" IsHitTestVisible="False" controls:InteractionMotion.IsEnabled="True"
                          controls:InteractionMotion.HoverOffset="-1">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ButtonFocusOutline" BorderBrush="#FFF0BC" BorderThickness="2" CornerRadius="2" Margin="3" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7" />
                            <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="2" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter TargetName="ButtonFocusOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#D5D0C5" />
                            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8" />
                            <Setter TargetName="ButtonFocusOutline" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/selfseat__selfSeatOkBtn_disabled.png" Stretch="Fill" /></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TableSecondaryButton" TargetType="Button" BasedOn="{StaticResource TablePrimaryButton}">
        <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/selfseat__selfSeatCancelBtn_normal.png" Stretch="Fill" /></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/selfseat__selfSeatCancelBtn_disabled.png" Stretch="Fill" /></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TableSortButton" TargetType="Button" BasedOn="{StaticResource TablePrimaryButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/selfseat__selfSeatResetBtn_normal.png" Stretch="Fill" /></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/selfseat__selfSeatResetBtn_normal.png" Stretch="Fill" /></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="EquipmentSlotTemplate">
        <Grid Width="142" Height="27" Margin="0,1" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
            <Grid.Background><ImageBrush ImageSource="pack://application:,,,/CardGame.Wpf;component/Assets/Table/seatbottom__self_seat_bg.png" ViewboxUnits="Absolute" Viewbox="0,0,298,68" Stretch="Fill" /></Grid.Background>
            <TextBlock x:Name="EmptySlotText" Text="{Binding SlotName}" Foreground="#928779" FontFamily="KaiTi" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image Source="{Binding Artwork}" Stretch="Fill" />
            <TextBlock Text="{Binding Name}" Foreground="#4D3923" FontFamily="KaiTi" FontSize="11"
                Margin="29,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                Visibility="{Binding HasDynamicWeaponName, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                <Image Source="{Binding RankArtwork}" Width="14" Height="16" Stretch="Uniform" />
                <Image Source="{Binding SuitArtwork}" Width="14" Height="16" Stretch="Uniform" />
            </StackPanel>
            <Button x:Name="StoneAxeEquipmentButton" Background="Transparent" BorderBrush="#D4B979" BorderThickness="1" Cursor="Hand"
                Command="{Binding DataContext.SelectEquipmentMaterialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}" Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}"
                ToolTip="选择此装备" AutomationProperties.Name="{Binding Tooltip}">
                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" /></ControlTemplate></Button.Template>
            </Button>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOccupied}" Value="True"><Setter TargetName="EmptySlotText" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="StoneAxeEquipmentButton" Property="Background" Value="#665EA78A" /><Setter TargetName="StoneAxeEquipmentButton" Property="BorderBrush" Value="#B5FFD7" /><Setter TargetName="StoneAxeEquipmentButton" Property="BorderThickness" Value="2" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="PortraitEquipmentSlotTemplate">
        <Grid Width="108" Height="14" Margin="0,0,0,1" Background="#E0D4BF9B" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="{Binding Tooltip}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="27" /></Grid.ColumnDefinitions>
            <Border Background="#A08C704D"><TextBlock Text="{Binding CompactSlotName}" FontSize="9" FontWeight="SemiBold" Foreground="#332719" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#332719" FontSize="9" FontFamily="KaiTi" Margin="2,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding CardMark}" Foreground="{Binding CardMarkBrush}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,2,0" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CompactSkillTemplate">
        <Border x:Name="SkillCardFrame" Margin="0,1,2,2" ToolTip="{Binding Tooltip}">
                <Button Command="{Binding DataContext.ActivateHumanSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Tooltip}" MaxWidth="104" Height="32" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsActiveSkillSelectionPending, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                            <Grid x:Name="SkillButtonSurface" IsHitTestVisible="False" controls:InteractionMotion.IsEnabled="True" controls:InteractionMotion.HoverOffset="-1.5" controls:InteractionMotion.PressedScale="0.975">
                                <Image x:Name="SkillButtonArtwork" Source="{Binding ButtonArtwork}" Stretch="Fill" />
                                <controls:SkillTypeIcon x:Name="SkillTypeIcon" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" IsConversion="{Binding IsConversion}" Visibility="{Binding IsConversion, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" Foreground="#FAF0DF" FontFamily="KaiTi" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,0,2,0">
                                    <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" /></TextBlock.Effect>
                                </TextBlock>
                                <Border x:Name="SkillFocusRing" BorderBrush="#FFE3A4" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border Background="#F02A2419" BorderBrush="#D8B86B" BorderThickness="1" CornerRadius="7" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0" IsHitTestVisible="False"
                                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ProgressText}" Foreground="#FFE5A0" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SkillButtonArtwork" Property="Source" Value="{Binding DisabledButtonArtwork}" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SkillButtonSurface" Property="Opacity" Value="0.85" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="SkillButtonSurface" Property="Opacity" Value="0.65" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SkillFocusRing" Property="Visibility" Value="Visible" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDisabled}" Value="True"><Setter TargetName="SkillCardFrame" Property="Opacity" Value="0.65" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


    <DataTemplate x:Key="JudgmentStatusTemplate">
        <Grid Width="32" Height="32" Margin="0,0,6,0" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Tooltip}">
            <Path Data="M 16,1 L 31,16 16,31 1,16 Z" Stroke="#E6CF78" StrokeThickness="1.5">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF6CC" Offset="0" />
                        <GradientStop Color="#D2B45F" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Data="M 16,4 L 28,16 16,28 4,16 Z" Stroke="#9E833F" StrokeThickness="0.7" IsHitTestVisible="False" />
            <TextBlock x:Name="JudgmentGlyph" Text="{Binding Glyph}" Foreground="#33291B" FontFamily="KaiTi" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Path x:Name="LightningGlyph" Data="M 19,5 L 8,18 15,18 12,27 25,12 18,12 Z" Fill="#35B9D4" Stroke="#FFF8D4" StrokeThickness="1.3" StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLightning}" Value="True">
                <Setter TargetName="JudgmentGlyph" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LightningGlyph" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="SeatStatusTemplate">
        <Grid x:Name="SeatStatusBadge" Width="30" Height="30" Margin="0,0,0,3" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Tooltip}">
            <Border x:Name="StatusBadgeSurface" CornerRadius="15" BorderBrush="#A5B38A" BorderThickness="1.2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#425B33" Offset="0" />
                        <GradientStop Color="#172717" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border CornerRadius="13" BorderBrush="#626F4B" BorderThickness="0.6" Margin="2">
                    <TextBlock Text="{Binding Label}" Foreground="#F5F1D8" FontFamily="KaiTi" FontSize="{Binding FontSize}" FontWeight="Bold" MaxWidth="26" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
            </Border>
            <Border x:Name="StatusCountBadge" Background="#282217" BorderBrush="#C9AE6F" BorderThickness="0.7" CornerRadius="5" MinWidth="12" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
                <TextBlock x:Name="StatusCountText" Text="{Binding CountText}" Foreground="#FFE3A4" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDrawPhaseBonus}" Value="True">
                <Setter TargetName="StatusBadgeSurface" Property="Background" Value="#172954" />
                <Setter TargetName="StatusBadgeSurface" Property="BorderBrush" Value="#7B91BD" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsTitle}" Value="True">
                <Setter TargetName="StatusBadgeSurface" Property="Background" Value="#312046" />
                <Setter TargetName="StatusBadgeSurface" Property="BorderBrush" Value="#A48CBB" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="SeatTemplate">
        <Grid Width="154" Height="204">
        <Button x:Name="SeatButton" Style="{StaticResource BareButton}" Cursor="Arrow" Width="154" Height="204" Command="{Binding DataContext.SelectTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="" ToolTip="{Binding PortraitTooltip}" ToolTipService.InitialShowDelay="450" controls:BattleFeedbackLayer.SeatAnchor="{Binding Seat}" controls:CardTargetingLayer.IsDraftTarget="{Binding IsSelectedTarget}">
            <Grid>
            <Border x:Name="SeatFrame" Background="#211D18" BorderBrush="#7C7056" BorderThickness="2" CornerRadius="2" Padding="2">
                <Grid>
                    <Grid ClipToBounds="True">
                        <Rectangle x:Name="SinglePortrait" Fill="{Binding Portrait.Brush}" />
                        <TextBlock x:Name="UnknownGeneral" Text="{Binding VerticalName}" TextAlignment="Center" FontSize="24" LineHeight="28" FontFamily="KaiTi" Foreground="#CABB95" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Fill="{StaticResource PortraitShade}" />
                        <Grid x:Name="DualPortraits" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="2" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <ContentControl x:Name="PrimaryGeneralPortrait" Content="{Binding PrimaryGeneral}" ContentTemplate="{StaticResource NationalGeneralSlotTemplate}" />
                            <Border Grid.Column="1" Background="#94805C" Opacity="0.65" />
                            <ContentControl x:Name="SecondaryGeneralPortrait" Grid.Column="2" Content="{Binding SecondaryGeneral}" ContentTemplate="{StaticResource NationalGeneralSlotTemplate}" />
                        </Grid>
                        <Border x:Name="FaceDownVeil" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#C4EEE7D5" Offset="0" />
                                    <GradientStop Color="#BFE5DABD" Offset="0.55" />
                                    <GradientStop Color="#00D7C8A5" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
