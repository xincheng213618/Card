                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DecisionRoleBadge" Visibility="{Binding HasDecisionRole, Converter={StaticResource BoolToVisibility}}" Background="#DD60482C" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,31,0,0" Padding="5,3" IsHitTestVisible="False">
                            <TextBlock Text="{Binding DecisionRoleLabel}" Foreground="#FFE4AB" FontSize="10" />
                        </Border>
                    </Grid>
                    <Border x:Name="ResponseStatusBadge" Background="#243E43" BorderBrush="#819FA4" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="3,0,0,5" Width="108" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="{Binding HasResponseStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="SeatResponseStatusText" Text="{Binding ResponseStatusText}" Foreground="#E8F5F0" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="SeatResponseOutline" BorderBrush="#9FBDC1" BorderThickness="1,0,1,0" Margin="7,25,7,29" Visibility="{Binding HasResponseStatus, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
            <Border x:Name="SeatSelectedOutline" BorderBrush="#FFE19C" BorderThickness="3" CornerRadius="2" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="SeatHoverOutline" BorderBrush="#C8F5D9" BorderThickness="1" CornerRadius="1" Margin="5" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="SeatFocusOutline" BorderBrush="#FFF4CE" BorderThickness="2" CornerRadius="1" Margin="5" Visibility="Collapsed" IsHitTestVisible="False" />
            <ItemsControl x:Name="SeatStatusBadges" ItemsSource="{Binding VisibleStatusBadges}" ItemTemplate="{StaticResource SeatStatusTemplate}" Width="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-24,28" Panel.ZIndex="4" Visibility="{Binding ShowPortraitStatuses, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl x:Name="SeatJudgmentStatuses" ItemsSource="{Binding JudgmentStatuses}" ItemTemplate="{StaticResource JudgmentStatusTemplate}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Visibility="{Binding ShowPortraitJudgment, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="判定区">
                <ItemsControl.LayoutTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75" /></ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            </Grid>
        </Button>
        <controls:IdentityMarkButton x:Name="IdentityMarkerButton" Style="{StaticResource BareButton}" MinWidth="24" MinHeight="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Panel.ZIndex="6" Visibility="{Binding CanMarkIdentity, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding IdentityMarkTooltip}" AutomationProperties.Name="{Binding IdentityMarkTooltip}">
            <Border x:Name="IdentityMarkerSurface" Background="{Binding RoleBrush}" Padding="6,3">
                <TextBlock Text="{Binding RoleBadgeText}" Foreground="#FFF4E0" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </controls:IdentityMarkButton>
        <StackPanel x:Name="PortraitPileBadges" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,34,25,0" Panel.ZIndex="5" MaxWidth="86">
            <Button x:Name="PrivateReserveBadge" Content="{Binding PrivateReserveText}" Command="{Binding DataContext.OpenPrivateReserveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" FontSize="11" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,3" Visibility="{Binding HasPrivateReserve, Converter={StaticResource BoolToVisibility}}" ToolTip="武将牌上的“星”；其他角色查看时仅显示牌背" AutomationProperties.Name="{Binding PrivateReserveText}" />
            <Button x:Name="TurnHandHoldBadge" Content="{Binding TurnHandHoldText}" Command="{Binding DataContext.OpenTurnHandHoldCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" FontSize="11" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,3" Visibility="{Binding HasTurnHandHold, Converter={StaticResource BoolToVisibility}}" ToolTip="暂存的手牌，回合结束时返还；其他角色查看时仅显示牌背" AutomationProperties.Name="{Binding TurnHandHoldText}" />
        </StackPanel>
        <StackPanel x:Name="NatureEffectBadges" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-16,6,0,0" Panel.ZIndex="5">
            <Border x:Name="GaleBadge" Width="29" Height="29" Background="#E52B2822" BorderBrush="#D6C697" BorderThickness="1.5" CornerRadius="15" Margin="0,0,0,4" Visibility="{Binding HasGale, Converter={StaticResource BoolToVisibility}}" ToolTip="狂风：受到的火焰伤害+1，持续至施加者的下回合开始" AutomationProperties.Name="狂风标记"><TextBlock Text="风" FontFamily="KaiTi" FontSize="21" Foreground="#E7DAB7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <Border x:Name="MistBadge" Width="29" Height="29" Background="#E5333940" BorderBrush="#CED5D8" BorderThickness="1.5" CornerRadius="15" Visibility="{Binding HasMist, Converter={StaticResource BoolToVisibility}}" ToolTip="大雾：防止非雷电伤害，持续至施加者的下回合开始" AutomationProperties.Name="大雾标记"><TextBlock Text="雾" FontFamily="KaiTi" FontSize="21" Foreground="#EDF0E7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding CanMarkIdentity}" Value="True">
                <Setter TargetName="KnownRoleBadge" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasResponseStatus}" Value="True">
                <Setter TargetName="SeatEquipmentRail" Property="Margin" Value="3,0,0,26" />
                <Setter TargetName="SeatNameView" Property="MaxHeight" Value="44" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHuman}" Value="True">
                <Setter TargetName="PortraitPileBadges" Property="VerticalAlignment" Value="Bottom" />
                <Setter TargetName="PortraitPileBadges" Property="Margin" Value="9,0,0,58" />
                <Setter TargetName="SeatVerticalName" Property="Text" Value="{Binding GeneralName}" />
                <Setter TargetName="SeatVerticalName" Property="FontSize" Value="14" />
                <Setter TargetName="SeatNameRail" Property="Margin" Value="29,2,0,0" />
                <Setter TargetName="SingleGeneralTitle" Property="Width" Value="96" />
                <Setter TargetName="SeatVerticalName" Property="Background" Value="{Binding KingdomBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusBadgesOnLeft}" Value="True">
                <Setter TargetName="SeatStatusBadges" Property="HorizontalAlignment" Value="Left" />
                <Setter TargetName="SeatStatusBadges" Property="Margin" Value="-24,4,0,28" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding StatusBadgesOnLeft}" Value="True" /><Condition Binding="{Binding HasGale}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter TargetName="SeatStatusBadges" Property="Margin" Value="-24,39,0,28" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding StatusBadgesOnLeft}" Value="True" /><Condition Binding="{Binding HasMist}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter TargetName="SeatStatusBadges" Property="Margin" Value="-24,39,0,28" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding StatusBadgesOnLeft}" Value="True" /><Condition Binding="{Binding HasGale}" Value="True" /><Condition Binding="{Binding HasMist}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter TargetName="SeatStatusBadges" Property="Margin" Value="-24,72,0,28" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding HasDualGenerals}" Value="True">
                <Setter TargetName="SinglePortrait" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="UnknownGeneral" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SingleGeneralTitle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SeatVerticalName" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DualPortraits" Property="Visibility" Value="Visible" />
                <Setter TargetName="DeathShade" Property="VerticalAlignment" Value="Top" />
                <Setter TargetName="DeathShade" Property="Margin" Value="0,27,0,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasPortrait}" Value="True">
                <Setter TargetName="UnknownGeneral" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasPortrait}" Value="False">
                <Setter TargetName="SeatVerticalName" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="SeatFrame" Property="BorderBrush" Value="#78CCB4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLegalTarget}" Value="True">
                <Setter TargetName="SeatButton" Property="Cursor" Value="Hand" />
                <Setter TargetName="SeatButton" Property="AutomationProperties.HelpText" Value="可选目标，点击选择" />
                <Setter TargetName="SeatFrame" Property="BorderBrush" Value="#9ADABC" />
                <Setter TargetName="SeatFrame" Property="BorderThickness" Value="2" />
                <Setter TargetName="TargetBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelectedTarget}" Value="True">
                <Setter TargetName="SeatButton" Property="Cursor" Value="Hand" />
                <Setter TargetName="SeatButton" Property="AutomationProperties.HelpText" Value="已选目标，再次点击取消" />
                <Setter TargetName="SeatFrame" Property="BorderBrush" Value="#FFE19C" />
                <Setter TargetName="SeatSelectedOutline" Property="Opacity" Value="1" />
                <Setter TargetName="TargetBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="TargetBadge" Property="Background" Value="#E8BC8950" />
                <Setter TargetName="TargetBadgeText" Property="Text" Value="✓ 已选定" />
                <Setter TargetName="TargetBadgeText" Property="Foreground" Value="#231C10" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsLegalTarget}" Value="True" />
                    <Condition Binding="{Binding ElementName=SeatButton, Path=IsMouseOver}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SeatHoverOutline" Property="Visibility" Value="Visible" />
                <Setter TargetName="TargetBadgeText" Property="Text" Value="点击选择" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelectedTarget}" Value="True" />
                    <Condition Binding="{Binding ElementName=SeatButton, Path=IsMouseOver}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SeatHoverOutline" Property="Visibility" Value="Visible" />
                <Setter TargetName="SeatHoverOutline" Property="BorderBrush" Value="#FFEBC6" />
                <Setter TargetName="TargetBadgeText" Property="Text" Value="点击取消" />
            </MultiDataTrigger>
            <Trigger SourceName="SeatButton" Property="controls:CardTargetingLayer.IsAimTarget" Value="True">
                <Setter TargetName="SeatHoverOutline" Property="Visibility" Value="Visible" />
                <Setter TargetName="SeatHoverOutline" Property="BorderBrush" Value="#97F0C0" />
                <Setter TargetName="SeatHoverOutline" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger SourceName="SeatButton" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SeatFocusOutline" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding HpUndefined}" Value="True">
                <Setter TargetName="SeatHealthIcons" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SeatHealthRail" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFaceDown}" Value="True" />
                    <Condition Binding="{Binding IsAlive}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="FaceDownVeil" Property="Visibility" Value="Visible" />
                <Setter TargetName="FaceDownLabel" Property="Visibility" Value="Visible" />
                <Setter TargetName="PortraitChain" Property="VerticalAlignment" Value="Bottom" />
                <Setter TargetName="PortraitChain" Property="Margin" Value="0,0,0,38" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsAlive}" Value="False">
                <Setter TargetName="DeathShade" Property="Visibility" Value="Visible" />
                <Setter TargetName="SeatFrame" Property="Opacity" Value="0.55" />
            </DataTrigger>
            <Trigger SourceName="SeatButton" Property="controls:BattleFeedbackLayer.IsDeathPending" Value="True">
                <Setter TargetName="DeathShade" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SeatFrame" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- One face for physical cards at every size. Suit and rank always come from the dealt card. -->
    <DataTemplate x:Key="CardCornerTemplate">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,7,0,0">
            <Grid Width="34" Height="31">
                <TextBlock x:Name="CardRank" Text="{Binding Rank}" FontFamily="Georgia" FontWeight="Bold" FontSize="22" Foreground="{Binding SuitBrush}" HorizontalAlignment="Center" />
                <Image Source="{Binding RankArtwork}" Stretch="Uniform" />
            </Grid>
            <Grid Width="34" Height="31">
                <TextBlock x:Name="CardSuit" Text="{Binding SuitGlyph}" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="{Binding SuitBrush}" HorizontalAlignment="Center" />
                <Image Source="{Binding SuitArtwork}" Stretch="Uniform" />
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasRankArtwork}" Value="True"><Setter TargetName="CardRank" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding HasSuitArtwork}" Value="True"><Setter TargetName="CardSuit" Property="Visibility" Value="Collapsed" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CardFaceTemplate">
        <Viewbox Stretch="Fill" IsHitTestVisible="False">
            <Grid Width="186" Height="260">
                <Image x:Name="CardArtwork" Source="{Binding Artwork}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="RuntimeCardName" Text="{Binding Name}" Foreground="#4D3923" FontFamily="KaiTi" FontSize="20"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="28,0,4,25"
                    Visibility="{Binding HasDynamicWeaponName, Converter={StaticResource BoolToVisibility}}" />
                <Grid x:Name="CardTextFallback" Visibility="Collapsed" Margin="14">
                    <TextBlock Text="{Binding VerticalName}" Foreground="{Binding AccentBrush}" FontFamily="KaiTi" FontWeight="Bold" FontSize="{Binding NameFontSize}" LineStackingStrategy="BlockLineHeight" LineHeight="{Binding NameLineHeight}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0" />
                    <TextBlock Text="{Binding KindLabel}" Foreground="#7A6549" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardCornerTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Border x:Name="CardIdentityRibbon" Height="44" VerticalAlignment="Center" Background="#F0E8D7B9" BorderBrush="#8D6041" BorderThickness="0,2" Visibility="{Binding HasIdentity, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="9,0">
                        <Path Data="M 2,31 L 23,6 30,3 27,11 7,33 Z" Fill="{Binding IdentityBrush}" Opacity="0.65" Width="32" HorizontalAlignment="Left" Stretch="Uniform" />
                        <TextBlock x:Name="CardIdentityLabel" Text="{Binding IdentityLabel}" Foreground="{Binding IdentityBrush}" FontFamily="KaiTi" FontSize="29" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:CardKind.ScarletBloodSword}">
                <Setter TargetName="RuntimeCardName" Property="Margin" Value="28,0,4,8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasArtwork}" Value="False">
                <Setter TargetName="CardTextFallback" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CardTemplate">
        <Grid x:Name="HandCardScaleRoot">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ElementName=HandCardScaleRoot, Path=(controls:HandPanel.CardScale)}" ScaleY="{Binding ElementName=HandCardScaleRoot, Path=(controls:HandPanel.CardScale)}" />
            </Grid.LayoutTransform>
        <Button x:Name="CardButton" Style="{StaticResource BareButton}" Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding IsPlayable}" VerticalAlignment="Bottom" Margin="0,18,0,0" ToolTip="{Binding CardHint}" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="{Binding CardHint}">
            <controls:CardLiftSurface x:Name="CardSurface" Width="110" Height="156" controls:BattleFeedbackLayer.HandAnchor="{Binding Id}" controls:CardTargetingLayer.IsDraftCard="{Binding IsSelected}" IsSelected="{Binding IsSelected}" IsPointerOver="{Binding RelativeSource={RelativeSource Self}, Path=(controls:HandPanel.IsPointerCard)}" MotionEnabled="{Binding DataContext.IsMotionEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True}">
            <Border x:Name="CardBorder" Background="{StaticResource CardPaper}" CornerRadius="3" BorderBrush="#7C7364" BorderThickness="1">
                    <Grid>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardFaceTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        <TextBlock Text="粮" Foreground="#F9EAC5" Background="#A074562A" FontSize="10" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Visibility="{Binding IsStoredGrain, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding OriginalHandTag}" Foreground="#F9EAC5" Background="#A074562A" FontSize="10" Padding="4,1" MaxWidth="70" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" Visibility="{Binding HasOriginalHandTag, Converter={StaticResource BoolToVisibility}}" />
                        <Border x:Name="SelectedCheck" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#9B783B" CornerRadius="8" Width="17" Height="17" Margin="3">
                            <TextBlock Text="✓" Foreground="#FFF3D2" HorizontalAlignment="Center" FontSize="11" />
                        </Border>
                    </Grid>
            </Border>
            <Border x:Name="CardSelectedOutline" BorderBrush="#FFE0A0" BorderThickness="3" CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
            </controls:CardLiftSurface>
        </Button>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="CardButton" Property="controls:HandPanel.IsPointerCard" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F4D390" />
            </Trigger>
            <Trigger SourceName="CardButton" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFF1B2" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFE0A0" />
                <Setter TargetName="CardSelectedOutline" Property="Opacity" Value="1" />
                <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlayable}" Value="False">
                <Setter TargetName="CardSurface" Property="Opacity" Value="0.55" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="RevealedCardTemplate">
        <Button Style="{StaticResource BareButton}" Command="{Binding DataContext.SelectRevealedCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding CardHint}">
            <Border Width="78" Height="109" Background="{StaticResource CardPaper}" BorderBrush="#BAA375" BorderThickness="1" CornerRadius="4" Margin="4" ToolTip="{Binding CardHint}">
                <Grid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardFaceTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <TextBlock Text="{Binding OriginalHandTag}" Foreground="#F9EAC5" Background="#D074562A" FontSize="10" Padding="3,1" MaxWidth="52" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Visibility="{Binding HasOriginalHandTag, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding PublicCardLabel}" FontSize="9" Foreground="#48341F" Background="#E8F4E6C8" Padding="3,1" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="76" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                </Grid>
            </Border>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="HarvestCardTemplate">
        <Button Command="{Binding DataContext.SelectRevealedCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="5" Cursor="Hand" ToolTip="{Binding CardHint}" AutomationProperties.Name="{Binding CardHint}" AutomationProperties.HelpText="点击此牌，获得到手牌中">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChoiceFrame" Background="#3B443E" BorderBrush="#B99A61" BorderThickness="2" CornerRadius="4" Padding="3">
                        <StackPanel>
                            <Grid Width="96" Height="134">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardFaceTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                <TextBlock Text="{Binding OriginalHandTag}" Foreground="#F9EAC5" Background="#D074562A" FontSize="10" Padding="3,1" MaxWidth="64" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Visibility="{Binding HasOriginalHandTag, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <Border x:Name="ChoiceCaption" Background="#314D43" CornerRadius="2" Margin="0,4,0,0" Padding="0,4">
                                <TextBlock Text="点击选取" Foreground="#FFF1CB" FontSize="12" TextAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#FFF0BA" /><Setter TargetName="ChoiceCaption" Property="Background" Value="#527663" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#FFF0BA" /><Setter TargetName="ChoiceCaption" Property="Background" Value="#527663" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChoiceFrame" Property="Background" Value="#61775D" /><Setter TargetName="ChoiceCaption" Property="Background" Value="#284337" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceFrame" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="TablePlayTemplate">
        <StackPanel Margin="5,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TablePlayFace, Path=(controls:BattleFeedbackLayer.IsFlightPending)}" Value="True">
                            <Setter Property="Opacity" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border x:Name="TablePlayFace" controls:BattleFeedbackLayer.PlayAnchor="{Binding Sequence}" Width="86" Height="120" CornerRadius="2" Background="{StaticResource CardPaper}" BorderBrush="#74634B" BorderThickness="1" ToolTip="{Binding Name}">
                <Grid>
                    <TextBlock x:Name="PlayTextFallback" Text="{Binding Name}" FontFamily="KaiTi" Foreground="#3F3830" FontSize="20" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0" TextWrapping="Wrap" />
                    <Viewbox Stretch="Fill">
                        <Grid Width="186" Height="260">
                            <Image Source="{Binding Artwork}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="PlayRuntimeCardName" Text="{Binding Name}" Foreground="#4D3923" FontFamily="KaiTi" FontSize="20"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="28,0,4,25"
                                Visibility="{Binding HasDynamicWeaponName, Converter={StaticResource BoolToVisibility}}" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardCornerTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
            <Border Width="86" Background="#E0231B13" Padding="3,4" ToolTip="{Binding Caption}">
                <TextBlock x:Name="PlayActorCaption" Text="{Binding Caption}" Foreground="#E5BD69" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasArtwork}" Value="True"><Setter TargetName="PlayTextFallback" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:CardKind.ScarletBloodSword}">
                <Setter TargetName="PlayRuntimeCardName" Property="Margin" Value="28,0,4,8" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="GeneralRosterButton" TargetType="Button">
        <Setter Property="Background" Value="#29251F" /><Setter Property="BorderBrush" Value="#514735" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="RosterRowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RosterRowBorder" Property="Background" Value="#383125" /><Setter TargetName="RosterRowBorder" Property="BorderBrush" Value="#B79B65" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RosterRowBorder" Property="BorderBrush" Value="#FFE0A2" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="RosterRowBorder" Property="Opacity" Value="0.8" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><DataTrigger Binding="{Binding IsPreviewSelected}" Value="True"><Setter Property="Background" Value="#4A3D28" /><Setter Property="BorderBrush" Value="#E2BE77" /></DataTrigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="GeneralRosterTemplate">
        <Button Style="{StaticResource GeneralRosterButton}" Command="{Binding DataContext.PreviewGeneralChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}" Margin="0,0,0,5" AutomationProperties.Name="{Binding Text}" ToolTip="{Binding SkillDescription}" ToolTipService.InitialShowDelay="650">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                <Border Width="46" Height="62" HorizontalAlignment="Left" BorderBrush="#86734E" BorderThickness="1" Background="{Binding Portrait.ThumbnailBrush}" />
                <Grid Grid.Column="1" Margin="2,3,10,3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding EditionText}" Foreground="#B3A17D" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Name}" Foreground="#F2D59A" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SkillName}" Foreground="#CBBF9F" FontSize="12" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border Grid.Column="2" Background="#201D18" BorderBrush="#64573E" BorderThickness="1" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kingdom}" Foreground="#C9CEA1" FontFamily="KaiTi" FontSize="18" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="GeneralChoiceTemplate">
        <Button Style="{StaticResource BareButton}" Width="142" Height="211" Margin="5,4" Command="{Binding DataContext.PreviewGeneralChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text}" ToolTip="{Binding SkillDescription}" ToolTipService.InitialShowDelay="650">
            <Border x:Name="GeneralFrame" BorderBrush="#6E6046" BorderThickness="2" Padding="2" Background="#211B16">
                <Grid>
                    <Rectangle Fill="{Binding Portrait.ThumbnailBrush}" />
                    <Rectangle Fill="{StaticResource PortraitShade}" />
                    <Image Source="/CardGame.Wpf;component/Assets/gallery-portrait-frame.png" Stretch="Fill" IsHitTestVisible="False" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D13C3528" Padding="6,2" Margin="7,7,0,0">
                        <TextBlock Text="{Binding Kingdom}" FontFamily="KaiTi" FontSize="18" Foreground="#F2E4C3" />
                    </Border>
                    <TextBlock Text="{Binding VerticalName}" FontFamily="KaiTi" FontWeight="Bold" Foreground="#FFE8BC" FontSize="21" LineHeight="23" Background="#8018130D" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" Padding="2" />
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock x:Name="GeneralHealthPreview" Text="{Binding HealthText}" Foreground="#DCE8C3" FontSize="10" TextAlignment="Right" Margin="0,0,0,5" />
                        <Border x:Name="ChoiceStatus" Background="#D2312920" BorderBrush="#847354" BorderThickness="1" Padding="3,4">
                            <TextBlock x:Name="ChoiceStatusText" Text="{Binding SkillName}" Foreground="#D8C9AB" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="GeneralFrame" Property="IsMouseOver" Value="True"><Setter TargetName="GeneralFrame" Property="BorderBrush" Value="#FFE0A2" /></Trigger>
            <DataTrigger Binding="{Binding IsPreviewSelected}" Value="True">
                <Setter TargetName="GeneralFrame" Property="BorderBrush" Value="#FFD28A" />
                <Setter TargetName="ChoiceStatus" Property="Background" Value="#AA78572B" />
                <Setter TargetName="ChoiceStatus" Property="BorderBrush" Value="#F5D591" />
                <Setter TargetName="ChoiceStatusText" Property="Text" Value="已 选 中" />
                <Setter TargetName="ChoiceStatusText" Property="Foreground" Value="#FFF0CA" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="ChoicePanel">
        <WrapPanel HorizontalAlignment="Center" />
    </ItemsPanelTemplate>
</ResourceDictionary>
