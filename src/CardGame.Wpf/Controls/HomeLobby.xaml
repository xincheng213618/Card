<UserControl x:Class="CardGame.Wpf.Controls.HomeLobby"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CardGame.Wpf.Controls"
             controls:InteractionMotion.MotionEnabled="{Binding IsMotionEnabled, FallbackValue=False}"
             AutomationProperties.Name="群雄逐鹿首页" Focusable="False">
    <UserControl.Resources>
        <Style x:Key="LobbyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F7DEAA" />
            <Setter Property="Background" Value="#77362B24" />
            <Setter Property="BorderBrush" Value="#A48A5C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid x:Name="LobbyInteractionSurface" IsHitTestVisible="False"
                                  controls:InteractionMotion.IsEnabled="True"
                                  controls:InteractionMotion.EnableHover="True"
                                  controls:InteractionMotion.HoverOffset="-3"
                                  controls:InteractionMotion.PressedScale="0.985">
                                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                    <ContentPresenter x:Name="LobbyContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <Border x:Name="LobbyHoverWash" Background="#14FFE3A2" BorderBrush="#FFE2A2" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="LobbyFocusOutline" BorderBrush="#FFFFD1" BorderThickness="2" CornerRadius="2" Margin="3" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LobbyHoverWash" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LobbyFocusOutline" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LobbyHoverWash" Property="Visibility" Value="Visible" /><Setter TargetName="LobbyHoverWash" Property="Background" Value="#25000000" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LobbyInteractionSurface" Property="Opacity" Value="0.42" /><Setter TargetName="LobbyHoverWash" Property="Visibility" Value="Collapsed" /><Setter TargetName="LobbyFocusOutline" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeCard" TargetType="Button" BasedOn="{StaticResource LobbyButton}">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="#DE251D19" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#211710" BlurRadius="18" ShadowDepth="5" Opacity="0.5" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource LobbyButton}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="5,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="UtilityIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#EACA8B" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="UtilityLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#F4E2BD" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="KaiTi" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFE0A0" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#1B0B05" BlurRadius="5" ShadowDepth="2" Opacity="0.9" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4E5CB" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Margin" Value="2,8,0,0" />
        </Style>
        <Style x:Key="ModeEntryArrow" TargetType="Border">
            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,14,12" /><Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#88291B12" /><Setter Property="BorderBrush" Value="#8CDBB674" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <LinearGradientBrush x:Key="CardShade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EF231812" Offset="0" /><GradientStop Color="#B52F1C15" Offset="0.50" /><GradientStop Color="#182F1C15" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/lobby-river-city.png" Stretch="UniformToFill" /></Grid.Background>
        <Border Background="#16EDC899" IsHitTestVisible="False" />
        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00221914" Offset="0.45" /><GradientStop Color="#90221914" Offset="1" /></LinearGradientBrush></Border.Background></Border>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="78" /></Grid.RowDefinitions>
            <!-- A quiet announcement strip and the local player replace online economy chrome. -->
            <Border Grid.Row="0" Background="#DD292420" BorderBrush="#8E7957" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Text="群雄逐鹿" FontFamily="KaiTi" FontSize="26" FontWeight="Bold" Foreground="#F6D494" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LobbyButton}" Content="联机房间" Click="OpenLanRooms" Padding="12,5" Margin="0,0,16,0" TabIndex="16" AutomationProperties.Name="局域网模式与房间" />
                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#D9BD83" FontSize="16" Margin="0,0,12,0" />
                        <TextBlock Text="运筹帷幄，落子三国。欢迎来到群雄逐鹿。" Foreground="#D5CAB4" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="本地玩家  /  单机对战" Foreground="#E5CEA2" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#A6322822" BorderBrush="#7AAA8A58" BorderThickness="0,1,1,1" Padding="2,12">
                <StackPanel>
                    <Button x:Name="LobbyGalleryButton" Style="{StaticResource UtilityButton}" Command="{Binding OpenGeneralGalleryCommand}" ToolTip="浏览武将与技能" AutomationProperties.Name="武将图鉴" TabIndex="8" Margin="3,0,3,18">
                        <StackPanel><TextBlock Text="&#xE77B;" Style="{StaticResource UtilityIcon}" /><TextBlock Text="武将图鉴" Style="{StaticResource UtilityLabel}" /></StackPanel>
                    </Button>
                    <Button x:Name="SetupHistoryButton" Style="{StaticResource UtilityButton}" Command="{Binding OpenHistoryCommand}" ToolTip="查看历史对局" AutomationProperties.Name="历史战绩" TabIndex="9" Margin="3,0,3,18">
                        <StackPanel><TextBlock Text="&#xE81C;" Style="{StaticResource UtilityIcon}" /><TextBlock Text="历史战绩" Style="{StaticResource UtilityLabel}" /></StackPanel>
                    </Button>
                    <Button x:Name="LobbyGuideButton" Style="{StaticResource UtilityButton}" Command="{Binding OpenContextGuideCommand}" ToolTip="规则与操作指南（F1）" AutomationProperties.Name="战局指南" TabIndex="10">
                        <StackPanel><TextBlock Text="&#xE8A5;" Style="{StaticResource UtilityIcon}" /><TextBlock Text="战局指南" Style="{StaticResource UtilityLabel}" /></StackPanel>
                    </Button>
                </StackPanel>
                </Border>
                <ScrollViewer x:Name="LobbyContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" PanningMode="VerticalOnly" Focusable="False">
                <Grid MaxWidth="1220" Margin="16,14,16,0">
                    <Grid.RowDefinitions><RowDefinition Height="0.25*" MinHeight="120" /><RowDefinition Height="0.75*" MinHeight="370" /><RowDefinition Height="Auto" MinHeight="68" /></Grid.RowDefinitions>
                    <!-- The welcome artwork is quiet scenery; auxiliary actions have one stable home on the left. -->
                    <Border x:Name="LobbyWelcomeBanner" Grid.Row="0" BorderBrush="#35E9D4AB" BorderThickness="1" CornerRadius="3" Margin="0,0,0,16" IsHitTestVisible="False">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B8F1DFC0" Offset="0" /><GradientStop Color="#8DEAD4B0" Offset="0.6" /><GradientStop Color="#15EAD4B0" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                            <Border Width="3" Margin="14,22,0,22" HorizontalAlignment="Left" Background="#A08B5E32" IsHitTestVisible="False" />
                            <Border Grid.Column="1" Margin="0,-20,14,-70" Opacity="0.68">
                                <Border.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/general-da-qiao.png" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="White" Offset="0.4" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.OpacityMask>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="32,0,0,0">
                                <TextBlock Text="三 国 风 云  ·  英 雄 辈 出" Foreground="#634E33" FontSize="11" Margin="3,0,0,5" />
                                <TextBlock Text="群雄集结" FontFamily="KaiTi" FontSize="38" FontWeight="Bold" Foreground="#4D3223" />
                                <TextBlock x:Name="LobbyWelcomeCaption" Text="寻访三国名将，纵横乱世风云" Foreground="#6D5137" FontFamily="KaiTi" FontSize="16" Margin="3,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Two horizontal cards flank one full-height featured battle entry. -->
                    <Grid Grid.Row="1" MaxHeight="510" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Button x:Name="ClassicBattleButton" Grid.Column="0" Grid.Row="0" Style="{StaticResource ModeCard}" Command="{Binding OpenLobbyCategoryCommand}" CommandParameter="identity" AutomationProperties.Name="经典场，选择身份对局" TabIndex="1">
                            <Grid ClipToBounds="True">
                                <Grid.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/general-sun-shangxiang.png" Viewbox="0,0,1,0.60" Stretch="UniformToFill" AlignmentY="Top" /></Grid.Background>
                                <Border Background="{StaticResource CardShade}" />
                                <Border BorderBrush="#6FBB995F" BorderThickness="1" Margin="4" />
                                <StackPanel VerticalAlignment="Center" Margin="12"><TextBlock Text="经典场" Style="{StaticResource CardTitle}" /><TextBlock Text="身份博弈 · 五人 / 八人" Style="{StaticResource CardCaption}" /></StackPanel>
                                <TextBlock Text="身 份" FontSize="10" Foreground="#D5BB84" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,16,0,0" />
                                <Border Style="{StaticResource ModeEntryArrow}"><TextBlock Text="›" Foreground="#F4D49A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" /></Border>
                            </Grid>
                        </Button>
                        <Button x:Name="TeamBattleButton" Grid.Column="0" Grid.Row="2" Style="{StaticResource ModeCard}" Command="{Binding OpenLobbyCategoryCommand}" CommandParameter="team" AutomationProperties.Name="演武场，选择二对二阵营对局" TabIndex="2">
                            <Grid ClipToBounds="True">
                                <Grid.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/general-taishi-ci.png" Viewbox="0,0,1,0.6" Stretch="UniformToFill" AlignmentY="Top" /></Grid.Background>
                                <Border Background="{StaticResource CardShade}" /><Border BorderBrush="#6FBB995F" BorderThickness="1" Margin="4" />
                                <StackPanel VerticalAlignment="Center" Margin="12"><TextBlock Text="演武场" Style="{StaticResource CardTitle}" /><TextBlock Text="2v2 阵营 · 并肩作战" Style="{StaticResource CardCaption}" /></StackPanel>
                                <TextBlock Text="协 作" FontSize="10" Foreground="#D5BB84" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,16,0,0" />
                                <Border Style="{StaticResource ModeEntryArrow}"><TextBlock Text="›" Foreground="#F4D49A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" /></Border>
                            </Grid>
                        </Button>
                        <Button x:Name="EnterBattleButton" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource ModeCard}" Command="{Binding OpenLobbyCategoryCommand}" CommandParameter="all" BorderBrush="#E4BC6B" AutomationProperties.Name="进入战场，选择模式与开局设置" TabIndex="0">
                            <Grid ClipToBounds="True">
                                <Grid.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/lobby-featured-general.png" Stretch="UniformToFill" AlignmentY="Top" /></Grid.Background>
                                <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#001B1010" Offset="0.3" /><GradientStop Color="#631B1010" Offset="0.6" /><GradientStop Color="#FA1B1010" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                <Border BorderBrush="#9CDDAB62" BorderThickness="1" Margin="5" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC64271E" BorderBrush="#C6A367" BorderThickness="0,0,1,1" Padding="12,7"><TextBlock Text="群 雄 逐 鹿" Foreground="#FFE2AA" FontSize="12" /></Border>
                                <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,24">
                                    <TextBlock x:Name="LobbyFeaturedTitle" Text="一局定乾坤" Style="{StaticResource CardTitle}" FontSize="34" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="选择模式 · 进入房间 · 安排 AI" Foreground="#F0DCBA" FontSize="13" LineHeight="20" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,14" />
                                    <Border Background="#E8793325" BorderBrush="#E3B870" BorderThickness="1" Padding="12,10"><TextBlock Text="进入战场  ›" Foreground="#FFE2AA" FontFamily="KaiTi" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="NationalBattleButton" Grid.Column="4" Grid.Row="0" Style="{StaticResource ModeCard}" Command="{Binding OpenLobbyCategoryCommand}" CommandParameter="national" AutomationProperties.Name="国战场，选择双将试验模式" TabIndex="3">
                            <Grid ClipToBounds="True">
                                <Grid.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/general-yuan-shao.png" Viewbox="0,0,1,0.6" Stretch="UniformToFill" AlignmentY="Top" /></Grid.Background>
                                <Border Background="{StaticResource CardShade}" /><Border BorderBrush="#6FBB995F" BorderThickness="1" Margin="4" />
                                <StackPanel VerticalAlignment="Center" Margin="12"><TextBlock Text="国战场" Style="{StaticResource CardTitle}" /><TextBlock Text="双将暗置 · 魏蜀争锋" Style="{StaticResource CardCaption}" /></StackPanel>
                                <TextBlock Text="试 验 模 式" FontSize="10" Foreground="#D5BB84" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,16,0,0" />
                                <Border Style="{StaticResource ModeEntryArrow}"><TextBlock Text="›" Foreground="#F4D49A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" /></Border>
                            </Grid>
                        </Button>
                        <Button x:Name="StartTutorialButton" Grid.Column="4" Grid.Row="2" Style="{StaticResource ModeCard}" Command="{Binding StartTutorialCommand}" AutomationProperties.Name="新手演练，学习四步基础操作" TabIndex="4">
                            <Grid ClipToBounds="True">
                                <Grid.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/general-lu-xun.png" Viewbox="0,0,1,0.6" Stretch="UniformToFill" AlignmentY="Top" /></Grid.Background>
                                <Border Background="{StaticResource CardShade}" /><Border BorderBrush="#6FBB995F" BorderThickness="1" Margin="4" />
                                <StackPanel VerticalAlignment="Center" Margin="12"><TextBlock x:Name="LobbyTutorialTitle" Text="新手演练" Style="{StaticResource CardTitle}" FontSize="28" /><TextBlock Text="四步入门 · 从容上阵" Style="{StaticResource CardCaption}" /></StackPanel>
                                <TextBlock Text="初 入 三 国" FontSize="10" Foreground="#D5BB84" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,16,0,0" />
                                <Border Style="{StaticResource ModeEntryArrow}"><TextBlock Text="›" Foreground="#F4D49A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" /></Border>
                            </Grid>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <WrapPanel HorizontalAlignment="Center">
                        <Button x:Name="ActivityBattleButton" Command="{Binding OpenLobbyCategoryCommand}" CommandParameter="activity" Style="{StaticResource LobbyButton}" Background="#B02B221D" Padding="32,8" AutomationProperties.Name="活动场，合作挑战与八人生存，玩家默认五阶" TabIndex="5">
                            <StackPanel><TextBlock x:Name="ActivityBattleTitle" Text="活动场 · 五阶战场" Foreground="#FFE0A0" FontFamily="KaiTi" FontSize="22" TextWrapping="Wrap" /><TextBlock Text="合作挑战  /  八人生存" Foreground="#F1DFC0" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                        </Button>
                        <Button x:Name="ShanheCampaignButton" Command="{Binding OpenShanheCommand}" Style="{StaticResource LobbyButton}" Background="#B02B221D" Padding="32,8" Margin="16,0,0,0" AutomationProperties.Name="山河图，有剧情的单机征程" TabIndex="6">
                            <StackPanel><TextBlock x:Name="ShanheCampaignTitle" Text="山河图 · 剧情征程" Foreground="#FFE0A0" FontFamily="KaiTi" FontSize="22" TextWrapping="Wrap" /><TextBlock Text="选路奇遇  /  战法构筑" Foreground="#F1DFC0" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                        </Button>
                        <Button x:Name="WushuangBattleButton" Command="{Binding OpenWushuangModeCommand}" Style="{StaticResource LobbyButton}" Background="#B02B221D" Padding="24,8" Margin="16,0,0,0" AutomationProperties.Name="单骑无双，15 分钟单机 1v1 AI，初始战法和两个额外技能" TabIndex="7">
                            <StackPanel><TextBlock x:Name="WushuangBattleTitle" Text="单骑无双 · 限时单挑" Foreground="#FFE0A0" FontFamily="KaiTi" FontSize="22" TextWrapping="Wrap"/><TextBlock Text="1v1 AI  /  虎符商店  /  两个额外技能" Foreground="#F1DFC0" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding TutorialEntryError}" Visibility="{Binding HasTutorialEntryError, Converter={StaticResource BoolToVisibility}}" Foreground="#FFE2CB" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SessionSaveStatus}" Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisibility}}" Foreground="#FFE2CB" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <Border x:Name="WushuangSaveAccessWarning" Visibility="{Binding HasWushuangSaveAccessError, Converter={StaticResource BoolToVisibility}}" Background="#D33D2C24" BorderBrush="#AC7859" BorderThickness="1" Padding="12,8" Margin="16,8,16,0" MaxWidth="760">
                            <DockPanel>
                                <Button x:Name="RetryWushuangSaveAccessButton" DockPanel.Dock="Right" Content="重试访问" Command="{Binding RetryWushuangSaveAccessCommand}" Style="{StaticResource LobbyButton}" Padding="12,7" Margin="14,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="重试访问单骑无双存档" TabIndex="17" />
                                <TextBlock x:Name="WushuangSaveAccessErrorText" Text="{Binding WushuangSaveAccessStatus}" Foreground="#FFE2CB" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="#EA292420" BorderBrush="#927957" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LobbyButton}" Command="{Binding CancelNewGameSetupCommand}" Padding="20,11" Background="#9B613622" BorderBrush="#B7975A" AutomationProperties.Name="返回当前牌桌" TabIndex="11"><TextBlock Text="返 回 牌 桌" FontFamily="KaiTi" FontSize="19" /></Button>
                        <Button x:Name="ContinueSavedGameButton" Style="{StaticResource LobbyButton}" Command="{Binding ContinueGameCommand}" Padding="16,11" Margin="12,0,0,0" Visibility="{Binding HasAutomaticSave, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding AutomaticSaveText}" AutomationProperties.Name="继续上次对局" TabIndex="12"><TextBlock Text="继续上次对局" FontSize="13" /></Button>
                        <Button x:Name="ContinueWushuangButton" Style="{StaticResource LobbyButton}" Command="{Binding ContinueWushuangCommand}" Padding="16,11" Margin="12,0,0,0" Visibility="{Binding HasWushuangSave, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="继续单骑无双独立存档" TabIndex="13"><TextBlock Text="继续单骑无双" FontSize="13"/></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource UtilityButton}" Command="{Binding LoadManualGameCommand}" ToolTip="{Binding ManualSaveText}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="读取手动存档" TabIndex="14"><StackPanel><TextBlock Text="&#xE8F1;" Style="{StaticResource UtilityIcon}" /><TextBlock Text="存档" Style="{StaticResource UtilityLabel}" /></StackPanel></Button>
                        <Button x:Name="LobbySettingsButton" Style="{StaticResource UtilityButton}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="游戏设置" TabIndex="15"><StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource UtilityIcon}" /><TextBlock Text="设置" Style="{StaticResource UtilityLabel}" /></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
