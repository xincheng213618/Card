<UserControl x:Class="CardGame.Wpf.Controls.ShanheSettlementPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F3DFAD"/><Setter Property="Background" Value="#733023"/><Setter Property="BorderBrush" Value="#AD8745"/><Setter Property="Padding" Value="22,11"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="3"><Border BorderBrush="#6D512F" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="Background" Value="#9B442C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFE69C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid Background="#E51A120D"><Viewbox Stretch="Uniform"><Grid Width="1200" Height="750">
  <Ellipse Width="830" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#67351D"/><GradientStop Color="#00281912" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
  <Border Margin="78,268,78,0" Height="67" VerticalAlignment="Top" BorderBrush="#916623" BorderThickness="0,1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#007A1911"/><GradientStop Color="#AB72160F" Offset=".25"/><GradientStop Color="#C0982513" Offset=".5"/><GradientStop Color="#AB72160F" Offset=".75"/><GradientStop Color="#007A1911" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <StackPanel Margin="160,127,160,0" VerticalAlignment="Top"><TextBlock Text="诸 侯 伐 董" FontFamily="KaiTi" FontSize="24" Foreground="#B99B64" TextAlignment="Center"/>
   <TextBlock Text="{Binding ShanheSettlementTitle}" FontFamily="KaiTi" FontSize="91" TextAlignment="Center" Margin="0,24,0,0"><TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF2B0"/><GradientStop Color="#F2CD5E" Offset=".5"/><GradientStop Color="#AE6F1F" Offset="1"/></LinearGradientBrush></TextBlock.Foreground><TextBlock.Effect><DropShadowEffect Color="#BA4916" BlurRadius="20" ShadowDepth="4" Opacity=".55"/></TextBlock.Effect></TextBlock>
   <TextBlock Text="{Binding ShanheSettlementSubtitle}" Foreground="#C6AE83" FontFamily="KaiTi" FontSize="19" TextWrapping="Wrap" TextAlignment="Center" Margin="0,45,0,0"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,398,0,0" Visibility="{Binding HasShanheBookReward, Converter={StaticResource VisibleWhen}}">
   <Border BorderBrush="#8C6138" BorderThickness="1" Background="#63351F" Padding="14,8" Margin="0,0,22,0"><TextBlock Text="通关&#x0a;奖励" Foreground="#E5C69B" FontFamily="KaiTi" FontSize="27" LineHeight="34" VerticalAlignment="Center"/></Border>
   <Border BorderBrush="#D3A454" BorderThickness="2" Background="#4B311E" Width="112" Height="102" ToolTip="图册可用于研习初始战法，并解锁征程中的技能与装备。"><Grid><Border BorderBrush="#896233" BorderThickness="1" Margin="4"/><Path Data="M22,22 Q40,15 55,24 Q70,15 88,22 L94,70 Q73,62 55,72 Q38,62 16,70 Z M55,24 L55,72 M30,30 L25,59 M39,29 L36,60 M71,29 L74,60 M80,30 L85,59" Fill="#C9AD73" Stroke="#6D4B25" StrokeThickness="2"/><TextBlock Text="{Binding ShanheSettlementBookText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#FFE4A3" FontSize="27" FontWeight="Bold" Margin="0,0,7,6"/></Grid></Border>
  </StackPanel>
  <TextBlock Text="{Binding ShanheSettlementReceipt}" Foreground="#BCA780" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Width="780" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,527,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,82"><Button x:Name="SettlementCloseButton" Content="返 回 征 程" Command="{Binding CloseShanheSettlementCommand}" Background="#3B3023"/><Button Content="查 看 山 河 册" Click="OpenCodex" Margin="20,0,0,0"/><Button Content="重试结算" Visibility="{Binding IsShanheSettlementPending, Converter={StaticResource VisibleWhen}}" Command="{Binding RetryShanheSettlementCommand}" Margin="20,0,0,0" Padding="13,11" FontSize="12"/></StackPanel>
 </Grid></Viewbox></Grid>
</UserControl>
