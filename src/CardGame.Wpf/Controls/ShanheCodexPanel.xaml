<UserControl x:Class="CardGame.Wpf.Controls.ShanheCodexPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style x:Key="InkButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F2DEAE"/><Setter Property="Background" Value="#493324"/>
   <Setter Property="BorderBrush" Value="#A38651"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFDC84"/><Setter TargetName="Edge" Property="Background" Value="#77512E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFE8A2"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LoadoutPlanButton" TargetType="Button" BasedOn="{StaticResource InkButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFDC84"/><Setter TargetName="Edge" Property="Background" Value="#77512E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFE8A2"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.45"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="1"/></DataTrigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#745332"/><Setter Property="BorderBrush" Value="#E6C477"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="NodeButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="FocusEdge" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusEdge" Property="Background" Value="#35FFF2CC"/><Setter TargetName="FocusEdge" Property="BorderBrush" Value="#A78945"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusEdge" Property="BorderBrush" Value="#8D3023"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#F32D2820"/><Setter Property="Foreground" Value="#EFDFC0"/><Setter Property="BorderBrush" Value="#A58950"/><Setter Property="Padding" Value="16"/></Style>
  <Style TargetType="ScrollBar">
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#55756043"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb MinWidth="35"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#91713D" CornerRadius="2" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Viewbox Stretch="Uniform">
  <Grid Width="1050" Height="535" ClipToBounds="True">
   <Image Source="/CardGame.Wpf;component/Assets/shanhe-codex-book.png" Stretch="Fill" IsHitTestVisible="False"/>
   <Canvas x:Name="CodexBookContent"><Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding IsShanheCodexLoadoutManagerOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
    <StackPanel Canvas.Left="27" Canvas.Top="139" Width="55">
     <TextBlock Text="山&#x0a;河&#x0a;册" FontFamily="KaiTi" FontSize="49" LineHeight="75" TextAlignment="Center" Foreground="#EAC777"><TextBlock.Effect><DropShadowEffect Color="#160900" BlurRadius="3" ShadowDepth="2" Opacity="0.8"/></TextBlock.Effect></TextBlock>
     <TextBlock Text="运筹帷幄" FontFamily="KaiTi" FontSize="13" Foreground="#A8864E" TextAlignment="Center" Margin="0,20,0,0"/>
    </StackPanel>
    <Border Canvas.Left="120" Canvas.Top="18" Width="220" Height="40" Background="#DD493321" BorderBrush="#AA8650" BorderThickness="1" Padding="8,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="初始战法" FontFamily="KaiTi" FontSize="15" Foreground="#EFDAAB"/><TextBlock x:Name="CodexSelectedLoadoutName" Text="{Binding ShanheCodexSelectedLoadoutName}" Foreground="#D8BC82" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShanheCodexSelectedLoadoutName}"/></StackPanel>
     <Button x:Name="CodexManageLoadoutsButton" Grid.Column="1" Content="管理方案" Command="{Binding OpenShanheCodexLoadoutManagerCommand}" Style="{StaticResource InkButton}" FontSize="10" Padding="4,4" VerticalAlignment="Center" AutomationProperties.Name="管理初始战法方案"/>
    </Grid></Border>
    <TextBlock Canvas.Left="121" Canvas.Top="64" Text="六位已开放 · 点击选位" FontSize="11" Foreground="#715539" Width="220" TextAlignment="Center"/>
    <ItemsControl Canvas.Left="128" Canvas.Top="82" Width="211" Height="390" ItemsSource="{Binding ShanheCodexSlots}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Width="100" Height="91" Style="{StaticResource NodeButton}" Command="{Binding DataContext.SelectCodexSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding SlotLabel}">
       <Grid>
        <Ellipse Width="73" Height="73" VerticalAlignment="Top" Stroke="{Binding Accent}" StrokeThickness="4"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.4,0.28"><GradientStop Color="#6D5138"/><GradientStop Color="#2F241E" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        <Ellipse Width="62" Height="62" VerticalAlignment="Top" Margin="0,5,0,0" Stroke="#957348" StrokeThickness="1"/>
        <Ellipse Width="80" Height="80" VerticalAlignment="Top" Margin="0,-3,0,0" Stroke="#F8D182" StrokeThickness="2" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}"/>
        <TextBlock Text="{Binding Glyph}" Foreground="#D6B276" FontFamily="KaiTi" FontSize="32" HorizontalAlignment="Center" Margin="0,13,0,0"/>
        <Image Source="{Binding TacticImage}" Width="68" Height="68" VerticalAlignment="Top" Margin="0,2,0,0" Stretch="Uniform"><Image.Clip><EllipseGeometry Center="34,34" RadiusX="34" RadiusY="34"/></Image.Clip></Image>
        <Border Background="#3E3025" BorderBrush="{Binding Accent}" BorderThickness="1,2,1,1" VerticalAlignment="Bottom" Padding="4,3"><TextBlock Text="{Binding Name}" Foreground="#F2DFB6" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Canvas.Left="120" Canvas.Top="477" Width="220"><TextBlock Text="{Binding ShanheCodexLoadoutCount}" Foreground="#614628" TextAlignment="Center" FontSize="12"/><TextBlock Text="装备方案随时保存 · 下次出征生效" Foreground="#8C6B42" TextAlignment="Center" FontSize="10" Margin="0,6,0,0"/></StackPanel>
    <TextBlock Canvas.Left="381" Canvas.Top="23" Text="战 法 研 习" FontFamily="KaiTi" FontSize="22" Foreground="#594029"/>
    <TextBlock Canvas.Left="525" Canvas.Top="31" Text="2026 诸侯伐董 · 滚轮横向翻阅" FontSize="10" Foreground="#80633D"/>
    <StackPanel Canvas.Left="806" Canvas.Top="22" Orientation="Horizontal"><TextBlock Text="山河册" Foreground="#705334" FontSize="12" VerticalAlignment="Center"/><Border Background="#402B1E" BorderBrush="#B2935C" BorderThickness="1" Padding="15,4" Margin="10,0,0,0"><TextBlock Text="{Binding ShanheBookBalance, StringFormat={}{0} 册}" Foreground="#F0D499" FontSize="17"/></Border></StackPanel>
    <CheckBox x:Name="CollectionToggle" Canvas.Left="946" Canvas.Top="32" Content="本次行装" IsChecked="{Binding ShanheCodexShowCollection}" Foreground="#705334" FontSize="10"/>
    <Grid Canvas.Left="374" Canvas.Top="82" Width="32" Height="355">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <Border Background="#88756043" Margin="0,0,0,4"><TextBlock Text="⚔&#x0a;攻&#x0a;击" Foreground="#F2DFAB" FontFamily="KaiTi" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border Grid.Row="1" Background="#88756043" Margin="0,0,0,4"><TextBlock Text="◇&#x0a;防&#x0a;御" Foreground="#F2DFAB" FontFamily="KaiTi" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border Grid.Row="2" Background="#88756043" Margin="0,0,0,4"><TextBlock Text="火&#x0a;爆&#x0a;发" Foreground="#F2DFAB" FontFamily="KaiTi" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border Grid.Row="3" Background="#88756043" Margin="0,0,0,4"><TextBlock Text="↶&#x0a;反&#x0a;击" Foreground="#F2DFAB" FontFamily="KaiTi" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border Grid.Row="4" Background="#88756043" Margin="0,0,0,4"><TextBlock Text="↑&#x0a;成&#x0a;长" Foreground="#F2DFAB" FontFamily="KaiTi" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
    <ScrollViewer x:Name="CodexTreeScroll" Canvas.Left="412" Canvas.Top="65" Width="615" Height="391" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
     <Grid Width="9970" Height="375">
      <ItemsControl ItemsSource="{Binding ShanheCodexLinks}" IsHitTestVisible="False" Opacity="0.65">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Path Data="{Binding Data}" Stroke="{Binding Color}" StrokeThickness="2.5"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding ShanheCodexColumns}" IsHitTestVisible="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/></Style></ItemsControl.ItemContainerStyle>
       <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#917A52" FontFamily="KaiTi" FontSize="13"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding ShanheCodexNodes}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Width="98" Height="72" Style="{StaticResource NodeButton}" Command="{Binding DataContext.SelectCodexNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}" ToolTipService.InitialShowDelay="250">
         <Button.ToolTip><StackPanel MaxWidth="300"><TextBlock Text="{Binding Name}" FontSize="18" Foreground="#E2C17D"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="22" Margin="0,8"/><TextBlock Text="{Binding CostLabel}" Foreground="#DBA46C"/><TextBlock Text="{Binding ActionHint}" TextWrapping="Wrap" Foreground="#AD9D7E" Margin="0,5,0,0"/><TextBlock Text="{Binding PathDescription}" TextWrapping="Wrap" Foreground="#AD9D7E" FontSize="11" MaxWidth="300" Margin="0,7,0,0"/></StackPanel></Button.ToolTip>
         <Grid>
          <Border BorderBrush="#9D3924" BorderThickness="1" CornerRadius="2" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}"/>
          <Grid Opacity="{Binding NodeOpacity}">
           <StackPanel Visibility="{Binding IsTactic, Converter={StaticResource VisibleWhen}}">
            <Grid Width="49" Height="49">
             <Ellipse Stroke="{Binding Accent}" StrokeThickness="4"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.4,0.3"><GradientStop Color="#6A6256"/><GradientStop Color="#272723" Offset=".85"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
             <Ellipse Stroke="#B4A280" StrokeThickness="1" Margin="6"/>
             <TextBlock Text="{Binding Glyph}" FontFamily="KaiTi" FontSize="25" Foreground="#DDD4BD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             <Image Source="{Binding TacticImage}" Margin="3" Stretch="Uniform"><Image.Clip><EllipseGeometry Center="21.5,21.5" RadiusX="21.5" RadiusY="21.5"/></Image.Clip></Image>
            </Grid>
            <TextBlock Text="{Binding Name}" FontFamily="KaiTi" FontSize="13" FontWeight="Bold" Foreground="#473721" TextAlignment="Center" Margin="0,2,0,0"/>
           </StackPanel>
           <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSkill, Converter={StaticResource VisibleWhen}}">
            <Border BorderBrush="{Binding Accent}" BorderThickness="2" Background="#C5AE83" Margin="3,0" Padding="5,4"><Border BorderBrush="#7D6848" BorderThickness="1"><TextBlock Text="{Binding Name}" FontFamily="KaiTi" FontSize="17" Foreground="#392F25" TextAlignment="Center" Padding="1,2"/></Border></Border>
            <TextBlock Text="{Binding StateLabel}" Foreground="#7B5E37" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
           </StackPanel>
           <StackPanel Visibility="{Binding IsEquipment, Converter={StaticResource VisibleWhen}}" HorizontalAlignment="Center">
            <Border BorderBrush="{Binding Accent}" BorderThickness="2" Width="37" Height="51" Background="#E8D9BA"><Grid><TextBlock Text="装" Foreground="#8F7956" FontFamily="KaiTi" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding CardImage}" Stretch="Fill" Visibility="{Binding HasCardImage, Converter={StaticResource VisibleWhen}}"/></Grid></Border>
            <TextBlock Text="{Binding Name}" Foreground="#473721" FontFamily="KaiTi" FontSize="13" TextAlignment="Center" Margin="0,2,0,0"/>
           </StackPanel>
          </Grid>
          <Border Background="#7E3022" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,1" Visibility="{Binding IsEquipped, Converter={StaticResource VisibleWhen}}"><TextBlock Text="装" Foreground="#FFE8AF" FontSize="9"/></Border>
         </Grid>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </Grid>
    </ScrollViewer>
    <Border Canvas.Left="373" Canvas.Top="458" Width="651" Height="57" Background="#EA3B3023" BorderBrush="#A98A51" BorderThickness="1" Padding="10,5">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedCodexNode.Name}" Foreground="#F0D29A" FontFamily="KaiTi" FontSize="16"/><TextBlock Text="{Binding SelectedCodexNode.Kind}" Foreground="#BEA479" Margin="8,3,0,0" FontSize="10"/><TextBlock Text="{Binding SelectedCodexNode.CostLabel}" Foreground="#BEA479" Margin="8,3,0,0" FontSize="10"/></StackPanel><TextBlock Text="{Binding SelectedCodexNode.ActionHint}" Foreground="#C3B18F" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="解锁所需路线" Command="{Binding UnlockCodexNodeCommand}" Style="{StaticResource InkButton}" Padding="8,4" Margin="3,0" FontSize="11"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="{Binding ShanheCodexEquipLabel}" Command="{Binding EquipCodexTacticCommand}" Style="{StaticResource InkButton}" Padding="2,3" FontSize="10"/><Button Content="卸下所选槽位" Command="{Binding RemoveCodexTacticCommand}" Style="{StaticResource NodeButton}" Foreground="#CEB37E" FontSize="9" Margin="0,3,0,0"/></StackPanel>
     </Grid>
    </Border>
    <Border Canvas.Left="370" Canvas.Top="58" Width="660" Height="395" Background="#F3E8D6B5" BorderBrush="#A78A56" BorderThickness="1" Padding="18" Visibility="{Binding ShanheCodexShowCollection, Converter={StaticResource VisibleWhen}}">
     <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="本次征程 · 行装" FontFamily="KaiTi" FontSize="24" Foreground="#513D27"/><TextBlock Text="{Binding ShanheBuildSummary}" TextWrapping="Wrap" Foreground="#80633D" FontSize="11" Margin="0,8,0,10"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ShanheCodexCards}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#B29A6B" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="#63432D" FontFamily="KaiTi" FontSize="18"/><TextBlock Text="{Binding Description}" Foreground="#6B5B43" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
    </Border>
   </Canvas>
   <Border x:Name="CodexPickerOverlay" Background="#B8000000" Visibility="{Binding IsShanheCodexPickerOpen, Converter={StaticResource VisibleWhen}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True">
    <Border Margin="62,40,25,37" BorderBrush="#AE9B76" BorderThickness="2" Background="#292823" Padding="21,13">
     <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="装备初始战法" FontFamily="KaiTi" FontSize="27" Foreground="#F0DEB3" TextAlignment="Center"/>
      <Button x:Name="PickerCloseButton" Content="×" Command="{Binding CloseShanheCodexPickerCommand}" Style="{StaticResource InkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="6,0" FontSize="23" AutomationProperties.Name="关闭战法选择"/>
      <TextBlock Grid.Row="1" Text="{Binding ShanheCodexSlotHint}" Foreground="#BCAA7B" FontSize="12" TextAlignment="Center"/>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
       <Border BorderBrush="#76694D" BorderThickness="1" Margin="0,0,15,0" Background="#25241F" Padding="12"><Grid>
        <TextBlock Text="尚未研习此品质的战法&#x0a;返回山河册，先选择节点解锁。" Foreground="#B2A384" FontSize="14" TextAlignment="Center" LineHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasShanheEquippableTactics}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ShanheEquippableTactics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Button Style="{StaticResource NodeButton}" Width="105" Height="112" Margin="5" Command="{Binding DataContext.SelectCodexNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Grid><Border BorderBrush="#D9BD65" BorderThickness="2" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}"/><StackPanel Margin="4"><TextBlock Text="{Binding Name}" Foreground="#E5C98C" FontFamily="KaiTi" FontSize="16" TextAlignment="Center"/><Grid Width="70" Height="70" Margin="0,6,0,0"><Ellipse Fill="#303A2B" Stroke="{Binding Accent}" StrokeThickness="5"/><Ellipse Margin="9" Stroke="#A5945D"/><TextBlock Text="{Binding Glyph}" FontFamily="KaiTi" FontSize="34" Foreground="#EBD79E" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding TacticImage}" Margin="3" Stretch="Uniform"/></Grid></StackPanel></Grid></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
       </Grid></Border>
       <Border Grid.Column="1" BorderBrush="#76694D" BorderThickness="1" Background="#20211D" Padding="18"><Grid Visibility="{Binding HasShanheEquippableTactics, Converter={StaticResource VisibleWhen}}"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="27"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{Binding SelectedCodexNode.TacticImage}" Width="62" Height="62" Stretch="Uniform"/><TextBlock Text="{Binding SelectedCodexNode.Name}" Foreground="#EED7A1" FontFamily="KaiTi" FontSize="29" TextAlignment="Center" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding SelectedCodexNode.Rarity, StringFormat={}{0}战法}" Foreground="#BEA476" TextAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="{Binding SelectedCodexNode.Description}" Foreground="#C9BD9C" FontSize="14" TextWrapping="Wrap" LineHeight="25" Margin="0,15"/>
        <Button x:Name="PickerEquipButton" Grid.Row="3" Content="装 备" Command="{Binding EquipCodexTacticCommand}" Style="{StaticResource InkButton}" Background="#8C3027" HorizontalAlignment="Center" Width="140" VerticalAlignment="Center" FontFamily="KaiTi" FontSize="22" Padding="8,5"/>
       </Grid></Border>
      </Grid>
     </Grid>
    </Border>
   </Border>
   <Border x:Name="CodexLoadoutManagerOverlay" Background="#B8000000" Visibility="{Binding IsShanheCodexLoadoutManagerOpen, Converter={StaticResource VisibleWhen}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" FocusManager.IsFocusScope="True">
    <Border Width="760" Height="438" BorderBrush="#AE9B76" BorderThickness="2" Background="#292823" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="31"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <TextBlock Text="初始战法 · 方案管理" FontFamily="KaiTi" FontSize="27" Foreground="#F0DEB3" TextAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="CodexLoadoutManagerCloseButton" Content="×" Command="{Binding CloseShanheCodexLoadoutManagerCommand}" Style="{StaticResource InkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="6,0" FontSize="23" AutomationProperties.Name="关闭初始战法方案管理"/>
