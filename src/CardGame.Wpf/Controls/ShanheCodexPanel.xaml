      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border BorderBrush="#76694D" BorderThickness="1" Background="#25241F" Padding="9"><DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="方案（最多 8 套）" Foreground="#D8C18B" FontSize="12" Margin="3,0,0,8"/>
        <ScrollViewer x:Name="CodexLoadoutPlansScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
         <ItemsControl x:Name="CodexLoadoutPlanList" ItemsSource="{Binding ShanheCodexLoadoutPlans}"><ItemsControl.ItemTemplate><DataTemplate>
          <Button x:Name="CodexLoadoutPlanSelectButton" Command="{Binding DataContext.SelectShanheCodexLoadoutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" Style="{StaticResource LoadoutPlanButton}" Margin="0,0,0,7" Padding="8,7">
           <StackPanel Width="274"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Foreground="#F0DCA8" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Grid.Column="1" Text="当前" Foreground="#FFE3A0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}"/>
           </Grid><TextBlock Text="{Binding Summary}" Foreground="#C1AF8A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="31" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/></StackPanel>
          </Button>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
       </DockPanel></Border>
       <Border Grid.Column="1" BorderBrush="#76694D" BorderThickness="1" Background="#20211D" Padding="15" Margin="15,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>
         <TextBlock Text="方案名称（最多 24 字）" Foreground="#D8C18B" FontSize="12" Margin="0,0,0,8"/>
         <TextBox x:Name="CodexLoadoutNameBox" Text="{Binding ShanheCodexLoadoutName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Background="#F0E1BC" Foreground="#3D3021" BorderBrush="#A98A51" BorderThickness="1" Padding="7,6" FontSize="13" AutomationProperties.Name="初始战法方案名称"/>
         <Button x:Name="CodexRenameLoadoutButton" Content="保存名称" Command="{Binding RenameShanheCodexLoadoutCommand}" Style="{StaticResource InkButton}" Margin="0,8,0,14" Padding="8,5"/>
         <Border BorderBrush="#655B46" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="CodexNewLoadoutButton" Content="新建空方案" Command="{Binding NewShanheCodexLoadoutCommand}" Style="{StaticResource InkButton}" FontSize="11" Padding="6,6" Margin="0,0,5,0"/>
          <Button x:Name="CodexCopyLoadoutButton" Grid.Column="1" Content="复制当前" Command="{Binding CopyShanheCodexLoadoutCommand}" Style="{StaticResource InkButton}" FontSize="11" Padding="6,6" Margin="5,0,0,0"/>
         </Grid>
         <Button x:Name="CodexDeleteLoadoutButton" Content="删除此方案" Command="{Binding DeleteShanheCodexLoadoutCommand}" Style="{StaticResource InkButton}" Background="#60362A" Margin="0,10,0,0" Padding="8,5"/>
         <TextBlock Text="至少保留一套方案。删除只移除此方案，已研习的战法仍会保留。" Foreground="#AFA180" TextWrapping="Wrap" FontSize="10" LineHeight="17" Margin="0,8,0,0"/>
        </StackPanel></ScrollViewer>
       </Border>
      </Grid>
      <TextBlock x:Name="CodexLoadoutManagerMessage" Grid.Row="3" Text="{Binding ShanheCodexMessage}" Foreground="#E9D3A4" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ShanheCodexMessage}" Margin="2,7,2,0"/>
     </Grid>
    </Border>
   </Border>
   <TextBlock Text="{Binding ShanheCodexMessage}" Foreground="#E9D3A4" Background="#CC35291F" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="900" Margin="0,0,0,1" Padding="10,3"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsShanheCodexLoadoutManagerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
 </Viewbox>
</UserControl>
