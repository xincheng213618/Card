<UserControl x:Class="CardGame.Wpf.Controls.WushuangShopPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1240" Height="650" FontFamily="KaiTi, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
 KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style x:Key="ImageButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#FFE4A5"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Outline" BorderBrush="Transparent" BorderThickness="1" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#F8D787"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="AfterOpening" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsWushuangOpening}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="FooterAction" TargetType="Button" BasedOn="{StaticResource ImageButton}">
   <Setter Property="Width" Value="64"/><Setter Property="Height" Value="78"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Image Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_bg_l.png" Stretch="Fill"/>
   <Image Grid.Column="1" Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_bg_r.png" Stretch="Fill"/>
  </Grid>
  <Grid Margin="24,0">
   <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="460"/><RowDefinition Height="102"/></Grid.RowDefinitions>
   <Grid>
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Width="260" Height="44" Padding="18,5">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="{Binding WushuangShopTitleImage}" Width="148" Stretch="Uniform"/>
      <Button Command="{Binding CloseWushuangShopCommand}" Style="{StaticResource ImageButton}" Width="40" Height="36" Margin="10,0,0,0" ToolTip="结束购买 · Esc">
       <Image Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_hide.png" Width="38"/>
      </Button>
     </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,4,0" VerticalAlignment="Top" ToolTip="本局虎符">
     <Image Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_hufu_icon.png" Width="32" Height="30"/>
     <TextBlock Text="{Binding WushuangProgressText}" FontSize="24" Foreground="#E8D5A3" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>
   </Grid>
   <ItemsControl x:Name="WushuangOfferChoices" Grid.Row="1" ItemsSource="{Binding WushuangOffers}" HorizontalAlignment="Center" VerticalAlignment="Top">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding WushuangOfferColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Grid Width="250" Height="450" Margin="16,7,16,0">
      <Grid.RowDefinitions><RowDefinition Height="384"/><RowDefinition Height="14"/><RowDefinition Height="52"/></Grid.RowDefinitions>
      <Grid x:Name="WushuangOfferFrame" Width="250" Height="384" ToolTip="{Binding Description}">
       <Image Source="{Binding FrameImage}" Stretch="Fill"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
        <Image Source="{Binding TypeImage}" Width="27" Height="27" Margin="0,0,9,0"/>
        <TextBlock Text="{Binding TypeText}" Foreground="#FBEAC5" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
       </StackPanel>
       <Grid Margin="21,35,21,16">
        <Image Source="{Binding Artwork}" Width="112" Height="178" VerticalAlignment="Top" Margin="0,35,0,0" Stretch="Uniform">
         <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style>
        </Image>
        <Grid x:Name="WushuangTacticArtwork" Width="116" Height="116" VerticalAlignment="Top" Margin="0,26,0,0" Visibility="{Binding IsTactic, Converter={StaticResource VisibleWhen}}">
         <Image Source="{Binding IconFrameImage}" Stretch="Uniform"/>
         <Image Source="{Binding Artwork}" Width="90" Height="90" Stretch="Uniform"/>
        </Grid>
        <Grid x:Name="WushuangSkillNamePlate" Width="128" Height="38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,65,0,0" Visibility="{Binding IsSkill, Converter={StaticResource VisibleWhen}}">
         <Image Source="/CardGame.Wpf;component/Assets/Wushuang/rogue1v1_skill_bg.png" Stretch="Fill" Opacity="0.72"/>
         <TextBlock Text="{Binding DisplayName}" FontSize="27" FontWeight="Bold" Foreground="#FFE3B4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect Color="#663A21" BlurRadius="2" ShadowDepth="0" Opacity="1"/></TextBlock.Effect></TextBlock>
        </Grid>
        <Grid Height="26" VerticalAlignment="Top" Margin="0,188,0,0" Visibility="{Binding IsTactic, Converter={StaticResource VisibleWhen}}">
         <Image Source="{Binding NameImage}" Stretch="Fill"/><TextBlock Text="{Binding DisplayName}" FontSize="21" FontWeight="Bold" Foreground="#F4DDB1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{Binding DetailText}" FontFamily="SimSun" Foreground="#6E441E" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="24" VerticalAlignment="Top">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="7,218,7,0"/><Setter Property="MaxHeight" Value="98"/><Style.Triggers>
          <DataTrigger Binding="{Binding IsSkill}" Value="True"><Setter Property="Margin" Value="7,159,7,0"/><Setter Property="MaxHeight" Value="166"/></DataTrigger>
          <DataTrigger Binding="{Binding IsCard}" Value="True"><Setter Property="Margin" Value="7,240,7,0"/><Setter Property="MaxHeight" Value="40"/><Setter Property="TextAlignment" Value="Center"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <Image Source="/CardGame.Wpf;component/Assets/Wushuang/rg1v1_full_replace.png" Width="112" Height="28" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-9" Visibility="{Binding RequiresReplacement, Converter={StaticResource VisibleWhen}}" ToolTip="已满替换：选择要替换的额外技能后才扣除虎符"/>
      </Grid>
      <Grid x:Name="WushuangPriceSlot" Grid.Row="2" Width="212" Height="52" HorizontalAlignment="Center">
       <Button Command="{Binding DataContext.BuyWushuangOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding IsEnabled}" Opacity="1" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding DisplayName}">
        <Grid Width="210" Height="48">
         <Image Source="{Binding PurchaseButtonImage}" Stretch="Fill"/>
         <Border BorderBrush="#A4A5A3" BorderThickness="1" Margin="1" Visibility="{Binding IsReadOnly, Converter={StaticResource VisibleWhen}}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DA777B7D" Offset="0"/><GradientStop Color="#ED303236" Offset="1"/></LinearGradientBrush></Border.Background></Border>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_hufu_icon.png" Width="30" Height="27" Margin="0,0,13,0" Visibility="{Binding ShowsPriceIcon, Converter={StaticResource VisibleWhen}}"/>
          <TextBlock Text="{Binding PriceText}" FontSize="28" Foreground="{Binding PriceForeground}" FontWeight="Bold" VerticalAlignment="Center"/>
         </StackPanel>
        </Grid>
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ImageButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPurchased}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
       <Image Source="/CardGame.Wpf;component/Assets/Wushuang/rogue1v1_had_buy.png" Width="100" Height="48" Stretch="Uniform" Visibility="{Binding IsPurchased, Converter={StaticResource VisibleWhen}}"/>
      </Grid>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Grid Grid.Row="2">
    <Button x:Name="WushuangCloseShopButton" Command="{Binding CloseWushuangShopCommand}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,16" ToolTip="返回牌桌 · Esc">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FooterAction}"><Style.Triggers><DataTrigger Binding="{Binding IsWushuangOpening}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <Grid Width="62" Height="74"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="26"/></Grid.RowDefinitions><Image x:Name="WushuangEndIcon" Source="/CardGame.Wpf;component/Assets/Wushuang/rg1v1_exit0.png" Width="48" Height="48"/><TextBlock Grid.Row="1" Text="{Binding WushuangCloseText}" FontSize="24" Foreground="#EAD69B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Button>
    <Grid Width="730" Height="32" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,37">
     <ProgressBar Minimum="0" Maximum="{Binding WushuangShopWindowSeconds, Mode=OneWay}" Value="{Binding WushuangShopSecondsRemaining, Mode=OneWay}" Visibility="{Binding IsWushuangShopInteractive, Converter={StaticResource VisibleWhen}}" Height="10">
      <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
       <Border Background="#2B211E" BorderBrush="#977E67" BorderThickness="1" CornerRadius="5" Padding="1">
        <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF8175" Offset="0"/><GradientStop Color="#F51C13" Offset="0.45"/><GradientStop Color="#B60905" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid>
       </Border>
      </ControlTemplate></ProgressBar.Template>
     </ProgressBar>
     <TextBlock Text="{Binding WushuangPromptText}" Foreground="#FFF1CF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1"/></TextBlock.Effect></TextBlock>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,16" Style="{StaticResource AfterOpening}">
     <Button x:Name="WushuangLockButton" Command="{Binding ToggleWushuangShopLockCommand}" Style="{StaticResource FooterAction}" ToolTip="{Binding WushuangLockText}"><Grid Width="62" Height="74"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="26"/></Grid.RowDefinitions><Image x:Name="WushuangLockIcon" Source="{Binding WushuangLockImage}" Width="48" Height="48"/></Grid></Button>
     <Button x:Name="WushuangRerollButton" Command="{Binding RerollWushuangShopCommand}" Style="{StaticResource FooterAction}" ToolTip="花费1虎符刷新所有商品">
      <Grid Width="62" Height="74"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="26"/></Grid.RowDefinitions><Image x:Name="WushuangRefreshIcon" Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_shop_refresh.png" Width="48" Height="48"/>
       <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="/CardGame.Wpf;component/Assets/Wushuang/roguelike1v1_hufu_icon.png" Width="23" Height="20"/><TextBlock Text="1" Foreground="#EBD49C" FontSize="23" Margin="5,0,0,0"/></StackPanel>
      </Grid>
     </Button>
    </StackPanel>
    <TextBlock Text="{Binding WushuangShopMessage}" Foreground="#FFD48C" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="80,0,80,6"/>
   </Grid>
   <Border Grid.Row="1" Background="#F12C2015" BorderBrush="#BA8D47" BorderThickness="1" Padding="25" VerticalAlignment="Bottom" Margin="140,0,140,0" Visibility="{Binding IsWushuangReplacementPending, Converter={StaticResource VisibleWhen}}">
    <StackPanel><TextBlock Text="{Binding WushuangReplacementTitle}" Foreground="#EAD69B" FontSize="22" TextWrapping="Wrap"/>
     <ItemsControl ItemsSource="{Binding WushuangSkillSlots}" Margin="0,14,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding DataContext.ReplaceWushuangSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" FontSize="22" Foreground="#FFE4AB" Background="#59391F" Padding="16,12" Margin="4" ToolTip="{Binding Description}"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl><Button Content="取消替换" Command="{Binding CancelWushuangReplacementCommand}" Foreground="#E5CEA1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
