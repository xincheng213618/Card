<UserControl x:Class="CardGame.Wpf.Controls.ShanheCampaignPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CardGame.Wpf.Controls" KeyboardNavigation.TabNavigation="Cycle"
 KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True"
 PreviewKeyDown="Campaign_PreviewKeyDown" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <UserControl.Resources>
  <Style x:Key="CampaignButton" TargetType="Button">
   <Setter Property="Foreground" Value="#EAD7AC"/><Setter Property="Background" Value="#30271E"/>
   <Setter Property="BorderBrush" Value="#9A8153"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
     <Border x:Name="Inset" BorderBrush="#406F5A3A" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#55402A"/><Setter TargetName="Frame" Property="BorderBrush" Value="#E0BD75"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Inset" Property="BorderBrush" Value="#FFE3A4"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#6D351D"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CampaignButton}">
   <Setter Property="Background" Value="#872D1E"/><Setter Property="BorderBrush" Value="#D2AC62"/><Setter Property="Foreground" Value="#FFE6AC"/>
   <Setter Property="FontFamily" Value="KaiTi"/><Setter Property="FontSize" Value="25"/><Setter Property="Padding" Value="28,9"/>
  </Style>
  <Style x:Key="QuietCampaignButton" TargetType="Button" BasedOn="{StaticResource CampaignButton}">
   <Setter Property="Background" Value="#201B16"/><Setter Property="BorderBrush" Value="#665840"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#B9AB8E"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="SetupSelector" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EEDBB4"/><Setter Property="Background" Value="#29231C"/><Setter Property="BorderBrush" Value="#8E7651"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#EBD9B8"/><Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="Row" Background="#29231C" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#625037"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#51412D"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#29231C" BorderBrush="#8E7651" BorderThickness="1"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="#C7AD79" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <TextBlock Margin="12,8,34,8" Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" VerticalAlignment="Center"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
      <Border Background="#29231C" BorderBrush="#B79A62" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ShanheBuildCardTemplate">
   <Border Background="#DFCEAA" BorderBrush="#A18454" BorderThickness="1" Padding="15,13" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleText}">
    <StackPanel>
     <TextBlock Text="{Binding Name}" Foreground="#533824" FontFamily="KaiTi" FontSize="23"/>
     <TextBlock Text="{Binding Description}" Foreground="#574731" FontSize="13" LineHeight="23" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding RuleDescription}" Foreground="#64543C" FontSize="12" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="{Binding HasRuleDescription, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Text="{Binding SourceText}" Foreground="#7C613B" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
    </StackPanel>
   </Border>
  </DataTemplate>
  <Style x:Key="CampaignTab" TargetType="TabItem">
   <Setter Property="Foreground" Value="#D5BD8C"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabFrame" Width="86" Height="94" Background="#D526211C" BorderBrush="#695238" BorderThickness="1" Margin="0,0,12,10" CornerRadius="3">
     <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#F4773024"/><Setter TargetName="TabFrame" Property="BorderBrush" Value="#E8C47D"/><Setter Property="Foreground" Value="#FFF0BB"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFrame" Property="BorderBrush" Value="#F5DA9B"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFrame" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RewardCardButton" TargetType="Button">
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2DDB8"/><GradientStop Color="#DFBE91" Offset="0.6"/><GradientStop Color="#EFDCB6" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="BorderBrush" Value="#9E80B3"/><Setter Property="BorderThickness" Value="5"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="RewardFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="7,8">
     <Border BorderBrush="#AFD9BF94" BorderThickness="1" Margin="4"><ContentPresenter/></Border>
    </Border>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding IsSkip}" Value="True"><Setter Property="Background" Value="#68251F18"/><Setter Property="BorderBrush" Value="#A18242"/></DataTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RewardFrame" Property="BorderBrush" Value="#E7BF6D"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RewardFrame" Property="BorderBrush" Value="#FFE7A0"/></Trigger>
     <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="RewardFrame" Property="BorderBrush" Value="#FFD56B"/><Setter TargetName="RewardFrame" Property="Effect"><Setter.Value><DropShadowEffect Color="#FFBB25" BlurRadius="17" ShadowDepth="0" Opacity="0.7"/></Setter.Value></Setter></DataTrigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RewardFrame" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="BossRewardFrame" TargetType="Border">
   <Setter Property="BorderBrush" Value="#AA864F"/><Setter Property="BorderThickness" Value="4"/><Setter Property="Margin" Value="8"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EFDEBB"/><GradientStop Color="#DABD91" Offset="0.7"/><GradientStop Color="#EBD7B1" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
  </Style>
  <Style x:Key="BossRewardGroupTab" TargetType="Border">
   <Setter Property="Background" Value="#A9854D28"/><Setter Property="BorderBrush" Value="#D4AA61"/>
   <Style.Triggers><DataTrigger Binding="{Binding Id}" Value="tactics"><Setter Property="Background" Value="#B99B5927"/><Setter Property="BorderBrush" Value="#E0B46B"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="cards"><Setter Property="Background" Value="#B99F632A"/><Setter Property="BorderBrush" Value="#E2B870"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="BossRewardGroupButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="GroupFrame" Style="{StaticResource BossRewardFrame}"><Border BorderBrush="#C4B89565" BorderThickness="1" Margin="4"><ContentPresenter/></Border></Border>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding Id}" Value="tactics"><Setter TargetName="GroupFrame" Property="BorderBrush" Value="#D3974B"/></DataTrigger>
     <DataTrigger Binding="{Binding Id}" Value="cards"><Setter TargetName="GroupFrame" Property="BorderBrush" Value="#D9A052"/></DataTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GroupFrame" Property="BorderBrush" Value="#EAC77D"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GroupFrame" Property="BorderBrush" Value="#FFF0B6"/></Trigger>
     <DataTrigger Binding="{Binding IsResolved}" Value="True"><Setter TargetName="GroupFrame" Property="BorderBrush" Value="#D1A260"/></DataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ReplacementUnderlay" TargetType="Border">
   <Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheSkillReplacementOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="ReplacementSkillButton" TargetType="Button">
   <Setter Property="Background" Value="#292B29"/><Setter Property="BorderBrush" Value="#74736A"/><Setter Property="Foreground" Value="#D1C9AF"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="SkillFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SkillFrame" Property="BorderBrush" Value="#CDB172"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SkillFrame" Property="BorderBrush" Value="#FFF0BB"/></Trigger>
    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="SkillFrame" Property="BorderBrush" Value="#FFDA78"/><Setter TargetName="SkillFrame" Property="BorderThickness" Value="2"/><Setter TargetName="SkillFrame" Property="Background" Value="#5D4A2E"/><Setter Property="Foreground" Value="#FFE8AC"/></DataTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SkillFrame" Property="Opacity" Value="0.52"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Width="1200" Height="750" Background="#211A14">
  <Image Source="/CardGame.Wpf;component/Assets/shanhe-desk.png" Stretch="Fill" IsHitTestVisible="False"/>
  <Border BorderBrush="#AA8050" BorderThickness="1" Margin="6" IsHitTestVisible="False"/>
  <Grid x:Name="CampaignContent" Margin="22,14,22,16">
   <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=ShanheSetupOverlay}" Value="Visible"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding Visibility, ElementName=ShanheRulesOverlay}" Value="Visible"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheEncounterPreviewOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheRewardOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheBossRewardOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheSkillReplacementOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="#A5211B15">
     <Border Background="#8A2C20" BorderBrush="#BB874B" BorderThickness="1" Padding="8,3"><TextBlock Text="山&#x0a;河" FontFamily="KaiTi" Foreground="#F6DDA1" FontSize="19" TextAlignment="Center"/></Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="山河图" FontFamily="KaiTi" FontSize="28" Foreground="#F1D7A1"/><TextBlock Text="单机 · 剧情征程" Foreground="#BDA581" FontSize="10" Margin="0,3,0,0"/></StackPanel>
    </StackPanel>
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Width="330" Height="65" BorderBrush="#A5804C" BorderThickness="1,0,1,2" CornerRadius="0,0,14,14">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EA171A17"/><GradientStop Color="#F0352920" Offset="1"/></LinearGradientBrush></Border.Background>
      <StackPanel VerticalAlignment="Center"><TextBlock FontFamily="KaiTi" FontSize="29" Foreground="#F6D990" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="诸 侯 伐 董"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheRunInProgress}" Value="True"><Setter Property="Text" Value="{Binding ShanheChapterTitle}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Foreground="#B99E6E" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="初平元年 · 群雄并起"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheRunInProgress}" Value="True"><Setter Property="Text" Value="{Binding ShanheChapterProgressText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="DetachWindowButton" Content="独立窗口" Style="{StaticResource QuietCampaignButton}" Click="OpenDetachedWindow" Margin="0,0,8,0" AutomationProperties.Name="在独立窗口打开山河图"/>
     <Button x:Name="ShanheCloseButton" Content="返回大厅 / 牌桌" Command="{Binding CloseShanheCommand}" Style="{StaticResource QuietCampaignButton}" AutomationProperties.Name="关闭山河图面板并保留征程"/>
    </StackPanel>
   </Grid>
   <TabControl x:Name="ShanheJourneyTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource CampaignTab}" Margin="0,10,0,0">
    <TabItem AutomationProperties.Name="山河图征途地图"><TabItem.Header><StackPanel><TextBlock Text="图" FontFamily="KaiTi" FontSize="31" TextAlignment="Center"/><TextBlock Text="征途地图" FontSize="12" Margin="0,7,0,0"/></StackPanel></TabItem.Header>
     <Grid ClipToBounds="True">
      <Viewbox Stretch="Uniform" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}"><controls:ShanheJourneyMap x:Name="ShanheMapRows"/></Viewbox>
      <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,16,14,0" Background="#D9EFDFBA" BorderBrush="#967147" BorderThickness="3,0,0,0" Padding="14,8" MaxWidth="680" IsHitTestVisible="False" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}">
       <StackPanel><TextBlock Text="{Binding ShanheChapterTitle}" FontFamily="KaiTi" FontSize="23" Foreground="#4B3625"/><TextBlock Text="{Binding ShanheChapterObjectiveText}" FontSize="12" LineHeight="19" Foreground="#715C40" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="600" HorizontalAlignment="Left" MaxHeight="43" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Border>
      <Grid x:Name="ShanhePreparationPage" Visibility="{Binding IsShanhePreparation, Converter={StaticResource BoolToVisibility}}">
       <Image Source="/CardGame.Wpf;component/Assets/shanhe-map.png" Stretch="UniformToFill" IsHitTestVisible="False"/>
       <Border Background="#B8EFDFBC" BorderBrush="#9F7C4F" BorderThickness="1" Margin="18,17"/>
       <Grid Margin="53,43,43,38"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,28,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="出 征 准 备" FontFamily="KaiTi" FontSize="45" Foreground="#58391E"/><TextBlock Text="{Binding SelectedShanheScenario.Name}" FontFamily="KaiTi" FontSize="24" Foreground="#80603B" Margin="0,13,0,0"/><Border Background="#885C3E23" Height="1" Margin="0,18,0,0"/></StackPanel>
         <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedShanheScenarioDescription}" Foreground="#624C32" FontSize="14" TextWrapping="Wrap" LineHeight="26"/><TextBlock Text="择一将，携战法，踏山河。" FontFamily="KaiTi" FontSize="25" Foreground="#7C5930" Margin="0,20,0,9"/><TextBlock Text="{Binding ShanhePreparationHint}" Foreground="#786246" FontSize="12" LineHeight="23" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="ShanhePrepareGeneralButton" Content="选择出征武将" Style="{StaticResource CampaignButton}" Click="PrepareExpedition" IsEnabled="{Binding CanPrepareShanheExpedition}"/><Button x:Name="ShanhePrepareCodexButton" Content="编辑山河册" Style="{StaticResource CampaignButton}" Click="PrepareCodex" Margin="12,0,0,0" IsEnabled="{Binding CanPrepareShanheExpedition}"/></StackPanel>
        </Grid>
        <Border Grid.Column="1" Background="#45291E" BorderBrush="#9C753F" BorderThickness="2" Padding="6"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{Binding SelectedShanhePortrait}"/><Border Grid.Row="1" Background="#42271B" Padding="8,13"><StackPanel><TextBlock Text="{Binding SelectedShanheGeneral.Name}" Foreground="#F2D79E" FontFamily="KaiTi" FontSize="31" TextAlignment="Center"/><TextBlock Text="{Binding SelectedShanheGeneralMeta}" Foreground="#BDA17A" FontSize="10" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border></Grid></Border>
       </Grid>
      </Grid>
      <Border VerticalAlignment="Bottom" Margin="12,0,12,9" BorderBrush="#807E6541" BorderThickness="0,1,0,0" Padding="0,9,0,0" IsHitTestVisible="False" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="◆ 金色可前往     ◇ 朱印当前所在     ● 青色已完成     · 灰色待开启" Foreground="#513C28" FontSize="12" Background="#BFEBDBB6" Padding="10,3" HorizontalAlignment="Center"/></Border>
      <Border x:Name="ShanheContextPanel" Width="342" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,56,16,28" Background="#FA29231C" BorderBrush="#C7A365" BorderThickness="1" Padding="18" MaxHeight="400">
       <Border.Effect><DropShadowEffect Color="#37220F" BlurRadius="18" ShadowDepth="4" Opacity="0.4"/></Border.Effect>
       <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ShanheChoices.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsShanheShopActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsShanheRewardOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsShanheBossRewardOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock Text="{Binding ShanheContextTitle}" Foreground="#E8C986" FontFamily="KaiTi" FontSize="25" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ShanheContextDescription}" Style="{StaticResource Caption}" Margin="0,10,0,14"/>
        <ItemsControl x:Name="ShanheChoiceRows" ItemsSource="{Binding ShanheChoices}"><ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.ChooseShanheOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource CampaignButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,9" Padding="10,9" AutomationProperties.Name="{Binding AccessibleName}"><StackPanel><TextBlock Text="{Binding Name}" Foreground="#F2D9A7" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="#C0AD8D" FontSize="11" LineHeight="18" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
    </TabItem>
    <TabItem AutomationProperties.Name="查看战法构筑与技能说明"><TabItem.Header><StackPanel><TextBlock Text="册" FontFamily="KaiTi" FontSize="31" TextAlignment="Center"/><TextBlock Text="山河册" FontSize="12" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding ShanheCodexPhaseText}" Foreground="#DBC393" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/><controls:ShanheCodexPanel x:Name="ShanheCodexHost" Grid.Row="1"/></Grid></TabItem>
    <TabItem AutomationProperties.Name="山河图商店"><TabItem.Header><StackPanel><TextBlock Text="商" FontFamily="KaiTi" FontSize="31" TextAlignment="Center"/><TextBlock Text="行军商店" FontSize="12" Margin="0,7,0,0"/></StackPanel></TabItem.Header><controls:ShanheShopPanel x:Name="ShanheShopHost"/></TabItem>
   </TabControl>
   <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,14">
    <Button x:Name="ShanheRulesButton" Content="玩法说明" Style="{StaticResource QuietCampaignButton}" Click="ShowRules" Padding="9,9" Width="86"/>
     <Button Content="出征整备" Style="{StaticResource QuietCampaignButton}" Click="PrepareExpedition" Margin="0,8,0,0" Padding="9,9" Width="86" Visibility="{Binding IsShanhePreparation, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanPrepareShanheExpedition}"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#EC231B14" BorderBrush="#A98450" BorderThickness="0,1,0,0" Padding="14,10" Margin="0,6,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="295"/></Grid.ColumnDefinitions>
     <Button x:Name="ShanheSelectGeneralButton" Style="{StaticResource QuietCampaignButton}" HorizontalContentAlignment="Left" Click="PrepareExpedition" Padding="4,1" HorizontalAlignment="Left" ToolTip="选择出征武将、剧本与难度" Visibility="{Binding IsShanhePreparation, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanPrepareShanheExpedition}"><StackPanel Orientation="Horizontal"><Border Width="43" Height="53" Background="{Binding SelectedShanhePortrait}" BorderBrush="#AD8F55" BorderThickness="1" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedShanheGeneral.Name}" FontFamily="KaiTi" FontSize="23" Foreground="#E9D29C"/><TextBlock Text="将池 · 出征整备" Style="{StaticResource Caption}" FontSize="10"/></StackPanel></StackPanel></Button>
     <StackPanel Orientation="Horizontal" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}"><Border Width="43" Height="53" Background="{Binding CurrentShanheGeneralPortrait}" BorderBrush="#AD8F55" BorderThickness="1" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentShanheGeneralName}" FontFamily="KaiTi" FontSize="23" Foreground="#E9D29C"/><TextBlock Text="{Binding CurrentShanheGeneralSkillsText}" Foreground="#B9A584" FontSize="10" MaxWidth="180" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
