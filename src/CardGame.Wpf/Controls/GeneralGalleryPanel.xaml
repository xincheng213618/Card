<UserControl x:Class="CardGame.Wpf.Controls.GeneralGalleryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Panel_Loaded" Unloaded="Panel_Unloaded" DataContextChanged="Panel_DataContextChanged"
             KeyboardNavigation.TabNavigation="Cycle" Focusable="False">
    <UserControl.Resources>
        <Style x:Key="GalleryTab" TargetType="Button" BasedOn="{StaticResource SelectedFilterButton}">
            <Setter Property="Foreground" Value="#D2C5A4" /><Setter Property="Background" Value="#302E29" />
            <Setter Property="BorderBrush" Value="#64583F" /><Setter Property="FontFamily" Value="KaiTi" />
            <Setter Property="FontSize" Value="19" /><Setter Property="MinWidth" Value="78" />
            <Setter Property="Margin" Value="0,0,3,0" /><Setter Property="Padding" Value="16,10" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="#79633F" /><Setter Property="Foreground" Value="#FFF0CA" /><Setter Property="BorderBrush" Value="#C6A86B" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="GallerySubtab" TargetType="Button" BasedOn="{StaticResource SelectedFilterButton}">
            <Setter Property="Foreground" Value="#C2B798" /><Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="#594C34" /><Setter Property="Foreground" Value="#FFE4A3" /><Setter Property="BorderBrush" Value="#BDA16B" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="GeneralPortraitCard" TargetType="Button">
            <Setter Property="Width" Value="136" /><Setter Property="Height" Value="192" />
            <Setter Property="Margin" Value="8,8,10,12" /><Setter Property="Padding" Value="3" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="#322B25" />
            <Setter Property="BorderBrush" Value="#A78559" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFE3A0" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFDF" /><Setter TargetName="Frame" Property="BorderThickness" Value="3" /></Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFE09C" /><Setter TargetName="Frame" Property="BorderThickness" Value="3" /></DataTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="GalleryCardTemplate">
            <Button Style="{StaticResource GeneralPortraitCard}" Command="{Binding DataContext.SelectGeneralGalleryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityText}" ToolTip="{Binding SkillDescription}">
                <Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="GeneralId" /><Binding Path="DataContext.SelectedGeneralGalleryEntry.GeneralId" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Button.Tag>
                <Grid ClipToBounds="True" Background="{Binding Portrait.Brush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26,0,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPortrait}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="将" FontFamily="KaiTi" FontSize="48" Foreground="#766346" TextAlignment="Center" />
                        <TextBlock Text="暂无立绘" Foreground="#A49376" FontSize="11" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B5161717" Offset="0" /><GradientStop Color="#00161717" Offset="0.6" /></LinearGradientBrush></Border.Background></Border>
                    <Border Height="27" VerticalAlignment="Top" Background="#AD17191A">
                        <Grid Margin="7,0"><TextBlock Text="{Binding Kingdom}" Foreground="{Binding FactionBrush}" FontFamily="KaiTi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Text="{Binding HealthText}" Foreground="#EFE3B9" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    </Border>
                    <TextBlock Text="{Binding VerticalName}" FontFamily="KaiTi" FontWeight="Bold" FontSize="21" LineHeight="23" Foreground="#FFF4D9" Margin="8,36,0,24" VerticalAlignment="Top"><TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Black" Opacity="1" /></TextBlock.Effect></TextBlock>
                    <Border Background="#DC24201B" VerticalAlignment="Bottom" Padding="4,4"><TextBlock Text="{Binding SkillName}" FontSize="10" Foreground="#E0C89F" TextTrimming="CharacterEllipsis" TextAlignment="Center" /></Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <Border x:Name="GalleryBrowseSurface" MaxWidth="1560" MaxHeight="1020" Margin="24" Padding="18,14" Background="#F52B2A28" BorderBrush="#A28C62" BorderThickness="2">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasGeneralGallerySelection}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Border BorderBrush="#655B45" BorderThickness="1" Padding="14,6,14,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="武 将 图 鉴" FontFamily="KaiTi" FontSize="30" FontWeight="Bold" Foreground="#EAD9AC" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="群 雄 逐 鹿" FontFamily="KaiTi" FontSize="15" Foreground="#A7946E" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Button x:Name="CloseGeneralGalleryButton" Content="关闭  ×" Command="{Binding CloseGeneralGalleryCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" AutomationProperties.Name="关闭武将图鉴" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                    <Button Content="‹" Click="SeriesPrevious_Click" Style="{StaticResource QuietButton}" FontSize="26" Margin="0" Padding="0" AutomationProperties.Name="向前浏览武将系列" />
                    <ScrollViewer x:Name="SeriesScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="SeriesScroller_PreviewMouseWheel" Focusable="False">
                        <ItemsControl x:Name="SeriesTabs" ItemsSource="{Binding GeneralGallerySeries}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding DataContext.SelectGeneralGallerySeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="{Binding Description}" Style="{StaticResource GalleryTab}" GotKeyboardFocus="SeriesTab_GotKeyboardFocus">
                                    <Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Id" /><Binding Path="DataContext.SelectedGeneralGallerySeries" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Button.Tag>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="2" Content="›" Click="SeriesNext_Click" Style="{StaticResource QuietButton}" FontSize="26" Margin="0" Padding="0" AutomationProperties.Name="向后浏览武将系列" />
                </Grid>
                <DockPanel Grid.Row="2" Margin="8,0,8,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding GeneralGallerySeriesDescription}" Foreground="#AD9C78" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <ItemsControl ItemsSource="{Binding GeneralGallerySubgroups}" Visibility="{Binding HasGeneralGallerySubgroups, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Name}" Command="{Binding DataContext.SelectGeneralGalleryGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource GallerySubtab}">
                                <Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Id" /><Binding Path="DataContext.SelectedGeneralGalleryGroup" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Button.Tag>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#6E161718" BorderBrush="#554D3D" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="GalleryScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="8,0,0,10">
                                <ItemsControl x:Name="GeneralGalleryCards" ItemsSource="{Binding GeneralGalleryGroups}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,8,0,8">
                                            <Grid Margin="8,7,18,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Height="1" Background="#706043" VerticalAlignment="Center" Margin="0,0,20,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#ECD3A0" FontFamily="KaiTi" FontSize="24" />
                                                <Grid Grid.Column="2"><Border Height="1" Background="#706043" VerticalAlignment="Center" Margin="20,0,100,0" /><TextBlock Text="{Binding CountText}" Foreground="#B89C64" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" /></Grid>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource GalleryCardTemplate}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" Foreground="#938772" FontSize="12" Margin="0,12,0,24" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoGeneralGalleryResults, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="没有符合筛选条件的武将" FontFamily="KaiTi" FontSize="24" Foreground="#D7C7A4" />
                                <Button Content="清除搜索与势力筛选" Command="{Binding ClearGeneralGalleryFiltersCommand}" Style="{StaticResource ToolbarButton}" Margin="0,18,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding GeneralGalleryFactions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding DataContext.SelectGeneralGalleryFactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource GallerySubtab}">
                                    <Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Id" /><Binding Path="DataContext.SelectedGeneralGalleryFaction" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Button.Tag>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="点击武将查看技能 · 滚轮浏览" Foreground="#97896E" FontSize="10" Margin="10,5,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="GeneralGallerySearchBox" Text="{Binding GeneralGallerySearchText, UpdateSourceTrigger=PropertyChanged}" Background="#191B1C" Foreground="#E9D9B5" BorderBrush="#827152" Padding="10,8,30,8" VerticalContentAlignment="Center" AutomationProperties.Name="搜索武将或技能" ToolTip="输入武将名、技能名或技能说明" />
                        <TextBlock Text="搜索武将 / 技能" Foreground="#8C836E" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding GeneralGallerySearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#B6A174" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding GeneralGalleryCountText}" Foreground="#C7AF78" FontSize="12" VerticalAlignment="Center" Margin="20,0,5,0" />
                </Grid>
            </Grid>
        </Border>
    </Border>
    <Border x:Name="GeneralDetailsPanel" Background="#F51B1B1A" BorderBrush="#A28C62" BorderThickness="2"
            Margin="42,42,42,38" MaxWidth="1500" MaxHeight="980" Padding="18"
            Visibility="{Binding HasGeneralGallerySelection, Converter={StaticResource BoolToVisibility}}"
            KeyboardNavigation.TabNavigation="Cycle">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="上一位" Command="{Binding PreviousGeneralDetailsCommand}" Style="{StaticResource ToolbarButton}" Padding="12,5" />
                    <TextBlock Text="武 将 信 息" FontFamily="KaiTi" FontSize="28" FontWeight="Bold" Foreground="#F4E5C5" Margin="28,0" VerticalAlignment="Center" />
                    <Button Content="下一位" Command="{Binding NextGeneralDetailsCommand}" Style="{StaticResource ToolbarButton}" Padding="12,5" />
                </StackPanel>
                <Button x:Name="CloseGeneralDetailsButton" Content="关闭 ×" Command="{Binding CloseGeneralGalleryDetailsCommand}"
                        Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="关闭武将详情" />
            </Grid>
            <Grid Grid.Row="1" Margin="10,12,10,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3.8*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="5.2*" /></Grid.ColumnDefinitions>
                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="714" Height="970" DataContext="{Binding SelectedGeneralGalleryEntry}">
                        <Image x:Name="SelectedGeneralPortraitImage" Source="{Binding Portrait.Image}" Stretch="UniformToFill" Margin="19,23,19,24" />
                        <Image Source="/CardGame.Wpf;component/Assets/gallery-portrait-frame.png" Stretch="Fill" IsHitTestVisible="False" />
                        <Image Source="{Binding FactionImage}" Width="156" Height="164" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,18,0,0" />
                        <ItemsControl ItemsSource="{Binding HealthImages}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="190,35,0,0" ToolTip="{Binding HealthText}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="48" Height="48" Margin="0,0,2,0" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding VerticalName}" FontFamily="KaiTi" FontWeight="Bold" FontSize="48" LineHeight="62" Foreground="#FFF4D9" Margin="52,0,0,135" VerticalAlignment="Bottom"><TextBlock.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="Black" /></TextBlock.Effect></TextBlock>
                        <Border Background="#DD201A16" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30,0,30,38" Padding="18,8" CornerRadius="4">
                            <TextBlock Text="{Binding Portrait.SkinName}" FontSize="22" Foreground="#ECD6A3" TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Viewbox>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="技 能" Command="{Binding SelectGeneralDetailsTabCommand}" CommandParameter="skills" Tag="{Binding IsGeneralSkillsTab}" Style="{StaticResource GalleryTab}" MinWidth="100" />
                        <Button Content="皮 肤" Command="{Binding SelectGeneralDetailsTabCommand}" CommandParameter="skins" Tag="{Binding IsGeneralSkinsTab}" Style="{StaticResource GalleryTab}" MinWidth="100" />
                        <Button Content="台 词" Command="{Binding SelectGeneralDetailsTabCommand}" CommandParameter="voices" Tag="{Binding IsGeneralVoicesTab}" Style="{StaticResource GalleryTab}" MinWidth="100" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#DB242321" BorderBrush="#827152" BorderThickness="1" Padding="20">
                        <Grid>
                            <ScrollViewer x:Name="GeneralSkillsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding IsGeneralSkillsTab, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel DataContext="{Binding SelectedGeneralGalleryEntry}">
                                    <Border Padding="16" Margin="0,0,0,16">
                                        <Border.Background><ImageBrush ImageSource="/CardGame.Wpf;component/Assets/gallery-skill-background.png" Stretch="Fill" /></Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontFamily="KaiTi" FontSize="32" FontWeight="Bold" Foreground="#F1D6A0" />
                                    <TextBlock Text="{Binding GroupName}" Foreground="#B7A88C" FontSize="14" Margin="0,8,0,14" />
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Kingdom}" Foreground="{Binding FactionBrush}" FontSize="18" /><TextBlock Text="{Binding HealthText}" Foreground="#E1CEAA" FontSize="16" Margin="20,0,0,0" /></StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="#64563E" Margin="0,0,0,18" />
                                    <TextBlock Text="武将技能" FontFamily="KaiTi" Foreground="#BBA374" FontSize="18" Margin="0,0,0,18" />
                                    <ItemsControl ItemsSource="{Binding Skills}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,0,0,26">
                                                <StackPanel Orientation="Horizontal">
                                                <Border HorizontalAlignment="Left" Background="#563225" BorderBrush="#94714B" BorderThickness="1" Padding="14,5" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Name}" FontFamily="KaiTi" FontWeight="Bold" FontSize="22" Foreground="#F1D6A0" />
                                                </Border>
                                                <Button Content="试听" Style="{StaticResource GallerySubtab}" Margin="8,0,0,10" Padding="10,5" ToolTip="试听此技能台词"
                                                        Visibility="{Binding HasVoice, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.PlayGeneralSkillVoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="16" LineHeight="28" Foreground="#DBD0B5" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Visibility="{Binding IsGeneralVoicesTab, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding SelectedGeneralGalleryEntry.Name, StringFormat={}{0} · 武将台词}" FontFamily="KaiTi" FontSize="24" Foreground="#F0D396" Margin="0,0,0,16" />
                                <ScrollViewer x:Name="GeneralVoicesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="这位武将暂未收录配音" Foreground="#B7A88C" Visibility="{Binding HasNoGeneralVoices, Converter={StaticResource BoolToVisibility}}" Margin="0,20" />
                                        <ItemsControl ItemsSource="{Binding GeneralVoices}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border BorderBrush="#64563E" BorderThickness="1" Background="#352E24" Padding="12" Margin="0,0,0,12">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Caption}" Foreground="#C9AD79" FontSize="13" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding LineText}" Foreground="#F0DFC0" FontSize="17" LineHeight="26" TextWrapping="Wrap" Margin="0,8,12,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="试听" Style="{StaticResource GallerySubtab}" Padding="12,7" VerticalAlignment="Center" AutomationProperties.Name="{Binding Caption}" Command="{Binding DataContext.PlayGeneralVoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Content="停止试听" Style="{StaticResource GallerySubtab}" Command="{Binding StopGeneralVoiceCommand}" Padding="10,5" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding GeneralVoiceStatus}" Foreground="#B7A88C" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                            <Grid Visibility="{Binding IsGeneralSkinsTab, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding SelectedGeneralGalleryEntry.Name, StringFormat={}{0} · 皮肤}" FontFamily="KaiTi" FontSize="24" Foreground="#F0D396" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <ScrollViewer x:Name="GeneralSkinsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedGeneralGalleryEntry.Skins}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Style="{StaticResource GeneralPortraitCard}" Width="122" Height="188" Margin="4,4,12,16"
                                                    Command="{Binding DataContext.SelectGeneralSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                                <Button.Tag><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="Id" /><Binding Path="DataContext.SelectedGeneralGalleryEntry.Portrait.SkinId" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Button.Tag>
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <Border VerticalAlignment="Bottom" Background="#E3211D19" Padding="3,6"><TextBlock Text="{Binding Name}" Foreground="#E8D7AF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" /></Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#DD785426" Padding="5,3">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="已使用" Foreground="#FFE9B6" FontSize="10" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Text="点击使用 · 仅切换外观 · 选择保存在本机" Foreground="#B7A88C" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
