  var exactTexts = [
    '请重新登录再试，登录验证失败。',
    '票据为空，请重新输入',
    '票据失效，请重新登录',
    '对不起，自动登录已失效，请重新登录'
  ];

  // ES5 安全 trim
  function trimText(str) {
    return str.replace(/^\s+|\s+$/g, '');
  }

  // ES5 includes 替代
  function containsExact(arr, value) {
    return arr.indexOf(value) !== -1;
  }

  var observer = new MutationObserver(function () {
    var el = document.querySelector('#SGS_login-error');
    if (!el) return;

    var text = trimText(el.innerText || '');

    if (containsExact(exactTexts, text)) {
      // console.log('命中完整匹配，隐藏错误提示：', text);
      el.style.display = 'none';

      // 命中一次即可，避免无意义监听
      observer.disconnect();
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();</script><script id="sgsCensus" src="https://web.sanguosha.com/sgsCensus/startup.php"></script><script src="https://web.sanguosha.com/static/js/captcha/index-1.0.1.js"></script><script src="https://web.sanguosha.com/static/js/sgslogin-sdk-972285.js"></script><script src="https://web.sanguosha.com/static/js/sgsReg-sdk-0f53fb.js"></script><script src="https://web.sanguosha.com/static/js/sgsSms-b5d8c8.js"></script></body></html>