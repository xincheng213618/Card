    {
      "area": "native prompt choice submission",
      "behavior": "Reject delayed or copied choice objects unless they are published by the exact current player snapshot.",
      "coverage": "Dying, Harvest, target-card, FireAttack, Nullification, Slash/Dodge response, program skill, and selected-hand response submissions share the guard."
    },
    {
      "area": "general gallery focus",
      "behavior": "Restore the original enabled browse card after bindings settle. Retire queued callbacks after details reopen, gallery closes, control unloads, or its view model changes."
    }
  ],
  "regressions": [
    {
      "name": "stale prompt choice",
      "before": {
        "status": "test-failed",
        "durationMs": 19200,
        "message": "RespondDodge: a stale button choice was rebound to the reloaded prompt and paid its cost."
      },
      "after": {
        "status": "passed",
        "cases": [
          "RespondDodge",
          "RespondSlash",
          "RescueDying",
          "Nullification",
          "FireAttackReveal",
          "FireAttackDiscard"
        ],
        "assertions": [
          "Reload replaces published objects even when ChoiceId repeats.",
          "Old and copied objects leave revision, card movements and complete snapshot unchanged.",
          "The exact current choice answers the exact current PromptId once.",
          "Retired choices cannot answer the next prompt."
        ]
      }
    },
    {
      "name": "gallery detail close",
      "before": {
        "status": "test-failed",
        "durationMs": 5525,
        "method": "Temporarily restore only the original synchronous Keyboard.Focus close branch, rebuild, run the same check, then restore the fix in finally.",
        "message": "Closing details must restore the original card after its real bindings enable browsing."
      },
      "after": {
        "status": "passed",
        "method": "Hidden WS_POPUP HwndSource without WS_VISIBLE; WS_EX_NOACTIVATE and TOOLWINDOW. Real loaded control, bindings and logical-focus fallback; remembered return target seeded because native keyboard focus is intentionally absent.",
        "assertions": [
          "The browse card is disabled during the SelectedGeneralGalleryEntry close notification.",
          "After bindings enable browsing, logical focus returns to the original card once.",
          "Close followed by immediate reopen leaves logical focus inside the new details.",
          "Closing the entire gallery retires its delayed focus callback and leaves match revision unchanged."
        ]
      }
    }
  ],
